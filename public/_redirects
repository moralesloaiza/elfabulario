# Redirects servidos por Cloudflare Pages.
# Sintaxis: <origen>  <destino>  <código>
# Más info: https://developers.cloudflare.com/pages/configuration/redirects/

# Las URLs de la antigua taxonomía plana `/etiquetas/<slug>/` ya no
# existen. La información se reparte ahora en cuatro dimensiones
# (personajes, temas, formas, tradiciones), por lo que un mapeo 1:1
# no es posible. Llevamos al visitante al índice de temas — el más
# cercano semánticamente — para que navegue desde ahí.
/etiquetas/*  /temas/  301

# Cambio de slug: el nombre histórico es Miguel Agustín Príncipe,
# no Miguel Ángel. La URL antigua queda viva con redirección permanente
# para no romper enlaces externos.
/autores/miguel-angel-principe/  /autores/miguel-agustin-principe/  301
/autores/miguel-angel-principe   /autores/miguel-agustin-principe/  301

# Fábula retirada: la única entrada de Sergio Laignelet sale del
# catálogo. Mandamos al visitante al índice general de fábulas.
/fabulas/la-liebre-y-la-tortuga/  /fabulas/  301
/fabulas/la-liebre-y-la-tortuga   /fabulas/  301

# Slug duplicado: existían dos versiones del mismo texto, la segunda
# (`la-codorniz-2`) era la buena. Tras consolidar en `la-codorniz`,
# redirigimos la URL antigua para no perder enlaces externos.
/fabulas/la-codorniz-2/  /fabulas/la-codorniz/  301
/fabulas/la-codorniz-2   /fabulas/la-codorniz/  301