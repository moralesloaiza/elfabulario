---
import type { CollectionEntry } from 'astro:content';
import FabulaCard from './FabulaCard.astro';
interface Props {
	rotulo: string;
	display: string;
	fabulas: CollectionEntry<'fabulas'>[];
	autorMap: Map<string, string>;
	contadorTexto: string;
	vacioTexto: string;
}

const { rotulo, display, fabulas, autorMap, contadorTexto, vacioTexto } = Astro.props;
---

<main class="page listado-taxonomia">
	{/* Cabecera a la izquierda (handoff §2, patrón Fase 2): eyebrow → H1 → conteo. */}
	<header class="cabecera">
		<p class="eyebrow">{rotulo}</p>
		<h1>{display}</h1>
	</header>

	<section class="listado" aria-labelledby="lista-titulo">
		<p class="conteo" id="lista-titulo">{contadorTexto}</p>

		{fabulas.length === 0 && <p class="vacio">{vacioTexto}</p>}

		{fabulas.length > 0 && (
			<ul class="rejilla" data-lista>
				{fabulas.map((f, i) => (
					<li class="rejilla-item" hidden={i >= 18}>
						<FabulaCard
							fabula={f}
							autorNombre={autorMap.get(f.data.autor.id) ?? 'Desconocido'}
							mostrarAutor={true}
						/>
					</li>
				))}
			</ul>
		)}

		{fabulas.length > 18 && (
			<button type="button" class="cargar-mas" data-cargar-mas>
				Mostrar más fábulas
			</button>
		)}
	</section>
</main>

<script>
	const PASO = 18;
	const boton = document.querySelector<HTMLButtonElement>('[data-cargar-mas]');
	const lista = document.querySelector<HTMLUListElement>('[data-lista]');

	if (boton && lista) {
		const items = Array.from(lista.children) as HTMLElement[];

		boton.addEventListener('click', () => {
			const ocultos = items.filter((el) => el.hasAttribute('hidden'));
			const lote = ocultos.slice(0, PASO);

			lote.forEach((el) => el.removeAttribute('hidden'));

			// Foco a la primera ficha del lote recién revelado, por accesibilidad.
			const primera = lote[0]?.querySelector<HTMLElement>('.card');
			if (primera) {
				primera.setAttribute('tabindex', '-1');
				primera.focus();
			}

			// Oculta el botón cuando ya no quedan fichas por revelar.
			if (ocultos.length <= PASO) {
				boton.setAttribute('hidden', '');
			}
		});
	}
</script>

<style>
	.listado-taxonomia {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6.25rem);
	}

	/* ── Cabecera (handoff §2): eyebrow(rótulo) → H1(término) ──────────────── */
	.cabecera {
		margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}
	.cabecera h1 {
		margin: var(--space-md) 0 0;
		font-size: var(--fs-3xl);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		text-wrap: balance;
	}

	/* ── Conteo sobre filete oro (eco de la barra de Fase 2) ──────────────── */
	.listado {
		border-top: var(--rule-thin) solid var(--color-oro);
		padding-top: var(--space-lg);
	}
	.conteo {
		margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
	}
	.vacio {
		font-family: var(--font-body);
		font-style: italic;
		color: var(--color-text-soft);
		margin: 0;
	}

	/* ── Rejilla de fichas (patrón Fase 2, filas 3:2 de FabulaCard) ───────── */
	.rejilla {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: clamp(24px, 3vw, 40px);
	}
	.rejilla-item {
		display: flex;
	}
	.rejilla-item[hidden] {
		display: none !important;
	}

	/* ── «Cargar más» (filete oro + Cinzel, patrón Fase 2/4) ──────────────── */
	.cargar-mas {
		display: block;
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		padding: var(--space-xs) var(--space-lg);
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-esmeralda);
		background: transparent;
		border: var(--rule-thin) solid var(--color-oro);
		cursor: pointer;
		transition: background-color var(--dur-fast) var(--ease-standard);
	}
	.cargar-mas:hover,
	.cargar-mas:focus-visible {
		background-color: rgba(201, 161, 74, 0.12);
	}
	.cargar-mas[hidden] {
		display: none !important;
	}
</style>
