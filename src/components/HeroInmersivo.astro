---
// Hero inmersivo a sangre para la portada (y, en Fase 3, para la fábula
// individual). Recorta la ilustración 3:2 a una franja 8:3 mediante
// `object-position: 50% <foco>%`, donde `foco` es el punto focal vertical en %
// desde arriba (ver optionalFoco en content.config.ts). El default lo aplica
// AQUÍ: 8 para ilustraciones de fábula/entrada, FOCO_RETRATO (15) para retratos.
//
// El título NO se pinta sobre la imagen: va en una banda inferior marfil, tras
// un filete doble. Fue una decisión explícita del handoff (mantiene la
// ilustración intacta y garantiza contraste AA sin apagar la imagen).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { FOCO_RETRATO } from '../consts';

interface Props {
	imagen: ImageMetadata;
	alt?: string;
	foco?: number;
	/** Retrato de autor → default de foco distinto y encuadre algo más alto. */
	esRetrato?: boolean;
	/** Altura fija del hero (p. ej. "300px"). Sin valor: franja 8:3 (mín. 520px). */
	altura?: string;
	/** Cintillo pequeño sobre el título (p. ej. "FÁBULA DE LA SEMANA · VERSO · 3 MIN"). */
	eyebrow: string;
	titulo: string;
	href: string;
	/** Autoría en cursiva esmeralda ("por Jean de La Fontaine"). */
	byline?: string;
	/** Entradilla de la columna derecha (normalmente el resumen). */
	lede?: string;
}

const {
	imagen,
	alt = '',
	foco,
	esRetrato = false,
	altura,
	eyebrow,
	titulo,
	href,
	byline,
	lede,
} = Astro.props;

const focoResuelto = foco ?? (esRetrato ? FOCO_RETRATO : 8);
// Altura fija → anula el aspect-ratio 8:3 y el min-height por defecto.
const heroVars = altura
	? `--hero-alto:${altura};--hero-aspecto:auto;--hero-min:0`
	: undefined;
---

<section class="hero" aria-label={`Destacado: ${titulo}`} style={heroVars}>
	{/* Imagen a sangre. Enlace solo para ratón: el enlace accesible es el título. */}
	<a class="hero-img" href={href} tabindex="-1" aria-hidden="true">
		<Image
			src={imagen}
			alt={alt}
			width={1600}
			height={1067}
			loading="eager"
			fetchpriority="high"
			style={`object-position: 50% ${focoResuelto}%`}
		/>
	</a>

	{/* Filete doble Art-Déco bajo el hero. */}
	<div class="hero-rule" aria-hidden="true"></div>

	{/* Banda de título: fondo marfil, contenido a ancho de página. */}
	<div class="hero-banda">
		<div class="hero-banda-inner page">
			<div class="hero-col-titulo">
				<p class="eyebrow">{eyebrow}</p>
				<h1 class="hero-titulo"><a href={href}>{titulo}</a></h1>
				{byline && <p class="hero-byline">{byline}</p>}
			</div>
			{lede && (
				<div class="hero-col-lede">
					<p>{lede}</p>
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.hero {
		margin: 0;
	}

	/* ---------- Imagen a sangre ---------- */
	.hero-img {
		display: block;
		width: 100%;
		height: var(--hero-alto, auto);
		aspect-ratio: var(--hero-aspecto, 8 / 3);
		min-height: var(--hero-min, 520px);
		overflow: hidden;
		/* Respaldo mientras carga la ilustración (gradiente Art-Déco). */
		background:
			radial-gradient(60% 80% at 28% 38%, #e8d3a0 0%, transparent 60%),
			linear-gradient(135deg, #f0e5ce 0%, #c9a14a 65%, #7a5f1f 100%);
	}
	.hero-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.hero:has(.hero-titulo a:hover) .hero-img :global(img),
	.hero:has(.hero-titulo a:focus-visible) .hero-img :global(img) {
		transform: scale(1.02);
	}

	/* ---------- Filete doble ---------- */
	.hero-rule {
		height: 5px;
		border-top: var(--rule-medium) solid var(--color-oro);
		border-bottom: var(--rule-hairline) solid var(--color-oro);
		background: var(--color-bg);
	}

	/* ---------- Banda de título ---------- */
	.hero-banda {
		background: var(--color-bg);
		padding-block: clamp(1.25rem, 2.4vw, 1.75rem);
	}
	.hero-banda-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: clamp(var(--space-lg), 3vw, 2.75rem);
	}
	.hero-col-titulo {
		flex: 1 1 420px;
		max-width: 820px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0 0 var(--space-xs);
	}
	.hero-titulo {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-tight);
		text-transform: uppercase;
		text-wrap: balance;
		margin: 0;
		color: var(--color-text);
	}
	.hero-titulo a {
		color: inherit;
		text-decoration: none;
	}
	.hero:has(.hero-titulo a:hover) .hero-titulo,
	.hero:has(.hero-titulo a:focus-visible) .hero-titulo {
		color: var(--color-oro-texto);
	}
	.hero-byline {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-esmeralda);
		margin: var(--space-md) 0 0;
	}
	.hero-col-lede {
		flex: 1 1 280px;
		max-width: 400px;
		border-left: var(--rule-thin) solid var(--color-oro);
		padding-left: clamp(var(--space-md), 2vw, var(--space-xl));
	}
	.hero-col-lede p {
		font-family: var(--font-body);
		font-size: var(--fs-md);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
		margin: 0;
	}

	@media (max-width: 720px) {
		.hero-img {
			/* Con altura fija (portada) se mantiene; en 8:3 se garantiza un mínimo. */
			min-height: var(--hero-min, 320px);
		}
		.hero-banda-inner {
			flex-direction: column;
			align-items: stretch;
		}
		.hero-col-lede {
			max-width: none;
		}
	}
</style>
