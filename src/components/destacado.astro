---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	cintillo: string;
	imagen: ImageMetadata;
	alt?: string;
	titulo: string;
	href: string;
}

const { cintillo, imagen, alt = '', titulo, href } = Astro.props;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
	<article class="frame destacado">
		<figure class="destacado-img">
			<Image src={imagen} alt={alt} width={1400} height={933} loading="eager" />
		</figure>
		<div class="destacado-meta">
			<p class="cintillo">{cintillo}</p>
			<h2 class="destacado-titulo">
				<a href={href}>{titulo}</a>
			</h2>
			<div class="destacado-submeta">
				<slot name="submeta" />
			</div>
		</div>
	</article>
</section>

<style>
	.destacado-seccion {
		margin-block: var(--space-2xl);
	}

	/* The .frame class supplies the canonical double gold border + 32px padding.
	   We add position:relative so the block-link ::before overlay can absolute-
	   position to the whole tarjeta. */
	.destacado.frame {
		position: relative;
		text-align: center;
	}

	.destacado-img {
		max-width: var(--measure-wide);
		width: 100%;
		margin: 0 auto var(--space-lg);
		aspect-ratio: 3 / 2;
		overflow: hidden;
	}
	.destacado-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.destacado:has(.destacado-titulo a:hover) .destacado-img :global(img),
	.destacado:has(.destacado-titulo a:focus-visible) .destacado-img :global(img) {
		transform: scale(1.02);
	}

	.destacado-meta {
		text-align: center;
	}

	/* Cintillo: small, gold, uppercase, wide letterspacing. Sits inside the
	   double-gold frame, above the title. */
	.cintillo {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0 0 var(--space-sm);
	}

	.destacado-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-2xl);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wider);
		line-height: var(--lh-snug);
		text-transform: uppercase;
		margin: 0 0 var(--space-md);
		color: var(--color-text);
	}
	.destacado-titulo a {
		text-decoration: none;
		color: inherit;
	}
	/* Block-link: the <a> wraps only the title, but its ::before overlay
	   extends the clickable area across the whole tarjeta. */
	.destacado-titulo a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.destacado:has(.destacado-titulo a:hover) .destacado-titulo,
	.destacado:has(.destacado-titulo a:focus-visible) .destacado-titulo {
		color: var(--color-oro-texto);
	}

	.destacado-submeta {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
	}
	.destacado-submeta :global(p) {
		margin: 0;
	}

	@media (max-width: 720px) {
		.destacado-titulo {
			font-size: var(--fs-xl);
		}
	}
</style>