---
// Banda del pódcast en la portada (dirección Cartelera): franja negra a sangre,
// compacta, con la frase a la izquierda y el CTA coral a la derecha. Enlace, no
// embed (el embed real vive en la ficha de fábula, Fase 3): cero JS de terceros.
// Nota WCAG: el rótulo sobre coral va en NEGRO (4.58:1 AA); en marfil no cumple.
import { SPOTIFY_SHOW_URL } from '../consts';
---

<section class="seccion-spotify" aria-labelledby="spotify-titulo">
	<div class="page spotify-inner">
		<p id="spotify-titulo" class="spotify-frase">
			Cada fábula, también narrada en voz alta.
		</p>
		<a
			class="spotify-cta"
			href={SPOTIFY_SHOW_URL}
			target="_blank"
			rel="noopener"
			aria-label="Escuchar en Spotify (se abre en una pestaña nueva)"
		>
			Escuchar en Spotify
		</a>
	</div>
</section>

<style>
	.seccion-spotify {
		background: var(--color-negro);
		border-block: var(--rule-thin) solid var(--color-oro);
	}
	.spotify-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-block: var(--space-sm);
	}
	.spotify-frase {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-marfil);
		margin: 0;
	}

	/* CTA coral: único uso de coral como fondo. Rótulo NEGRO (AA). Radio 0. */
	.spotify-cta {
		flex: 0 0 auto;
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		font-weight: var(--fw-regular);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-negro);
		background: var(--color-coral);
		padding: var(--space-xs) var(--space-lg);
		transition: filter var(--dur-fast) var(--ease-standard);
	}
	.spotify-cta:hover,
	.spotify-cta:focus-visible {
		filter: brightness(0.93);
		outline: none;
	}
	.spotify-cta:focus-visible {
		outline: var(--rule-thin) solid var(--color-marfil);
		outline-offset: 2px;
	}
</style>
