---
interface Props {
	activa: 'todas' | 'cartas';
}
const { activa } = Astro.props;

const claseTodas = activa === 'todas' ? 'tab active' : 'tab';
const claseCartas = activa === 'cartas' ? 'tab active' : 'tab';
const ariaTodas = activa === 'todas' ? 'page' : undefined;
const ariaCartas = activa === 'cartas' ? 'page' : undefined;
---

<nav class="entradas-tabs" aria-label="Filtrar entradas">
	<a href="/entradas/" class={claseTodas} aria-current={ariaTodas}>Todas las entradas</a>
	<span class="tab-sep" aria-hidden="true">·</span>
	<a href="/entradas/cartas/" class={claseCartas} aria-current={ariaCartas}>Solo cartas</a>
</nav>

<style>
	.entradas-tabs {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-md);
		margin: var(--space-xl) 0 var(--space-2xl);
		flex-wrap: wrap;
	}
	.tab {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-text-soft);
		text-decoration: none;
		padding-block: var(--space-2xs);
		border-bottom: var(--rule-medium) solid transparent;
		transition:
			color var(--dur-base) var(--ease-standard),
			border-color var(--dur-base) var(--ease-standard);
	}
	.tab:hover,
	.tab:focus-visible {
		color: var(--color-oro-texto);
	}
	.tab.active {
		color: var(--color-text);
		border-bottom-color: var(--color-oro);
	}
	.tab-sep {
		color: var(--color-oro);
		font-family: var(--font-display);
	}
</style>