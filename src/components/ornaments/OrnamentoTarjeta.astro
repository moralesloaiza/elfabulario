---
/* ============================================================
   El Fabulario · Ornamento para tarjetas sin ilustración
   Composición: Sol Art-Déco centrado en viewBox 3:2.
   El marco doble dorado se aplica desde el contenedor padre
   (.card-img.con-ornamento en FabulaCard.astro) replicando la
   convención .frame canónica de global.css.
   Hereda color via currentColor.
   ============================================================ */
---

<svg
	class="ornamento"
	viewBox="0 0 300 200"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	preserveAspectRatio="xMidYMid meet"
>
	<!-- Sol centrado: viewBox base 100x50 escalado x1.5 = 150x75.
	     Centro horizontal: (300-150)/2 = 75.
	     Posición vertical 60 deja al sol con aire arriba y horizonte abajo. -->
	<g transform="translate(75, 60)">
		<g transform="scale(1.5)">
			<path d="M 25 48 A 25 25 0 0 1 75 48" fill="none" stroke="currentColor" stroke-width="1.2"/>
			<circle cx="50" cy="48" r="3" fill="currentColor"/>
			<line x1="50" y1="48" x2="50" y2="18" stroke="currentColor" stroke-width="0.8"/>
			<line x1="50" y1="48" x2="36" y2="22" stroke="currentColor" stroke-width="0.8"/>
			<line x1="50" y1="48" x2="64" y2="22" stroke="currentColor" stroke-width="0.8"/>
			<line x1="50" y1="48" x2="25" y2="32" stroke="currentColor" stroke-width="0.8"/>
			<line x1="50" y1="48" x2="75" y2="32" stroke="currentColor" stroke-width="0.8"/>
		</g>
	</g>
</svg>

<style>
	.ornamento {
		color: var(--color-oro);
	}
</style>