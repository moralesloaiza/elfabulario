---
const today = new Date();
const startYear = 2026;
const yearLabel =
	today.getFullYear() === startYear
		? `${startYear}`
		: `${startYear}–${today.getFullYear()}`;
---

<footer>
	<div class="page footer-inner">
		<p class="cita">
			MVTATO NOMINE DE TE FABVLA NARRATVR
		</p>
		<p class="cita-fuente">
			Horacio · Sátiras I, 1, 69
		</p>

		<hr class="ornate" />

		<p class="meta">
			© {yearLabel} El Fabulario · Una colección dirigida por
			Alejandro de Morales y Loaiza
		</p>
		<p class="meta">
			Colaboraciones y contacto:
			<a href="mailto:contacto@elfabulario.com">contacto@elfabulario.com</a>
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: var(--space-4xl);
		padding-block: var(--space-2xl);
		background: var(--color-bg);
		border-top: var(--rule-hairline) solid var(--color-oro);
		position: relative;
	}
	footer::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 5px;
		height: var(--rule-hairline);
		background: var(--color-oro);
	}
	.footer-inner {
		text-align: center;
	}
	.cita {
		font-family: var(--font-body);
		font-size: var(--fs-lg);
		font-style: normal;
		line-height: var(--lh-snug);
		color: var(--color-text);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-xs);
	}
	.cita-fuente {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		/*text-align: center;*/
		/* uppercase eliminado: Cinzel ya es all-caps */
		color: var(--color-oro-texto);
		margin: 0 auto var(--space-xl);
	}
	.cita-ref {
		font-style: italic;
		text-transform: none;
		letter-spacing: var(--ls-wide);
	}
	footer hr.ornate {
		margin-block: var(--space-xl);
		max-width: 240px;
	}
	.meta {
		font-family: var(--font-body);
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: var(--space-xs) auto;
		max-width: var(--measure);
	}
	.meta a {
		color: var(--color-link);
	}
</style>
