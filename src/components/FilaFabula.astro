---
// Fila ilustrada para "Últimas fábulas" en la portada. Imagen y texto en flex,
// el lado de la imagen ALTERNA por posición (row / row-reverse). La ilustración
// se recorta a 4:3 con el `foco` de la fábula (en el listado, Fase 2, se usa el
// 3:2 nativo; aquí el handoff pide 4:3). Si no hay ilustración, cae al ornamento.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { FORMAS_DISPLAY, TRADICIONES_DISPLAY } from '../utils/taxonomia';
import OrnamentoTarjeta from './ornaments/OrnamentoTarjeta.astro';

interface Props {
	fabula: CollectionEntry<'fabulas'>;
	autorNombre: string;
	minutos: number;
	/** true → imagen a la derecha (row-reverse). */
	invertir?: boolean;
}

const { fabula, autorNombre, minutos, invertir = false } = Astro.props;
const { titulo, resumen, ilustracion, foco, forma, tradicion } = fabula.data;
const focoResuelto = foco ?? 8;

// Portada: "Tradición · Forma · N min" (el prefijo "Lectura ·" es del listado
// y la ficha, no de la portada — así el · separa ítems sin ambigüedad).
const meta = [
	tradicion ? TRADICIONES_DISPLAY[tradicion] : null,
	FORMAS_DISPLAY[forma],
	`${minutos} min`,
].filter(Boolean);
---

<article class:list={['fila', { invertir }]}>
	<figure class:list={['fila-img', { 'con-ornamento': !ilustracion }]}>
		{ilustracion ? (
			<Image
				src={ilustracion}
				alt=""
				width={720}
				height={480}
				loading="lazy"
				style={`object-position: 50% ${focoResuelto}%`}
			/>
		) : (
			<OrnamentoTarjeta />
		)}
	</figure>

	<div class="fila-texto">
		{autorNombre && <p class="fila-eyebrow">por {autorNombre}</p>}
		<h3 class="fila-titulo">
			<a href={`/fabulas/${fabula.id}/`}>{titulo}</a>
		</h3>
		{resumen && <p class="fila-resumen">{resumen}</p>}
		<hr class="fila-filete" aria-hidden="true" />
		<p class="fila-meta">{meta.join(' · ')}</p>
	</div>
</article>

<style>
	.fila {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: clamp(var(--space-lg), 3vw, var(--space-3xl));
	}
	.fila.invertir {
		flex-direction: row-reverse;
	}

	/* ---------- Imagen 4:3 con foco ---------- */
	.fila-img {
		flex: 1 1 340px;
		margin: 0;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}
	.fila-img.con-ornamento {
		position: relative;
		background: var(--color-marfil-alt);
		border: var(--rule-medium) solid var(--color-oro);
	}
	.fila-img.con-ornamento::before {
		content: '';
		position: absolute;
		inset: 6px;
		border: var(--rule-hairline) solid var(--color-oro);
		pointer-events: none;
	}
	.fila-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.fila-img :global(svg.ornamento) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.fila:has(.fila-titulo a:hover) .fila-img :global(img),
	.fila:has(.fila-titulo a:focus-visible) .fila-img :global(img) {
		transform: scale(1.02);
	}

	/* ---------- Texto ---------- */
	.fila-texto {
		flex: 1 1 340px;
		min-width: 300px;
	}
	.fila-eyebrow {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-esmeralda);
		margin: 0 0 var(--space-2xs);
	}
	.fila-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-xl);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-wider);
		line-height: var(--lh-snug);
		text-transform: uppercase;
		text-wrap: balance;
		margin: 0 0 var(--space-sm);
		color: var(--color-text);
	}
	.fila-titulo a {
		color: inherit;
		text-decoration: none;
	}
	.fila-titulo a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.fila:has(.fila-titulo a:hover) .fila-titulo,
	.fila:has(.fila-titulo a:focus-visible) .fila-titulo {
		color: var(--color-oro-texto);
	}
	.fila-resumen {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
		margin: 0 0 var(--space-md);
	}
	.fila-filete {
		width: 120px;
		height: 0;
		border: 0;
		border-top: var(--rule-thin) solid var(--color-oro);
		margin: 0 0 var(--space-sm);
	}
	.fila-meta {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}

	@media (max-width: 720px) {
		.fila,
		.fila.invertir {
			flex-direction: column;
			align-items: stretch;
		}
		.fila-texto {
			min-width: 0;
		}
	}
</style>
