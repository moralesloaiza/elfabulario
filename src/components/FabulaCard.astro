---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import OrnamentoTarjeta from './ornaments/OrnamentoTarjeta.astro';

interface Props {
	fabula: CollectionEntry<'fabulas'>;
	autorNombre: string;
	mostrarAutor?: boolean;
}

const { fabula, autorNombre, mostrarAutor = true } = Astro.props;
const { titulo, ilustracion, fecha } = fabula.data;
---

<article class="card">
	<figure class:list={['card-img', { 'con-ornamento': !ilustracion }]}>
		{ilustracion ? (
			<Image
				width={900}
				height={600}
				src={ilustracion}
				alt=""
				loading="lazy"
			/>
		) : (
			<OrnamentoTarjeta />
		)}
	</figure>
	<div class="card-meta">
		<h3 class="card-titulo">
			<a href={`/fabulas/${fabula.id}/`}>{titulo}</a>
		</h3>
		{mostrarAutor && <p class="card-autor">por {autorNombre}</p>}
		<p class="card-fecha">
			<FormattedDate date={fecha} />
		</p>
	</div>
</article>

<style>
	/* The card is the positioning context for the block-link pseudo-element. */
	.card {
		display: flex;
		flex-direction: column;
		position: relative;
	}

	/* Frame: aspect ratio shared by both image and ornament variants */
	.card-img {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		margin: 0 0 var(--space-md);
	}

	/* Ornament variant: double gold border, replicates the canonical .frame */
	.card-img.con-ornamento {
		position: relative;
		background: #EADDC0; /* slightly shaded marfil, candidate token --color-marfil-shade */
		border: var(--rule-medium) solid var(--color-oro);
	}
	.card-img.con-ornamento::before {
		content: "";
		position: absolute;
		inset: 6px;
		border: var(--rule-hairline) solid var(--color-oro);
		pointer-events: none;
	}

	.card-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.card-img :global(svg.ornamento) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.card:has(.card-titulo a:hover) .card-img :global(img),
	.card:has(.card-titulo a:focus-visible) .card-img :global(img) {
		transform: scale(1.02);
	}

	.card-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}

	/* Block-link: the <a> wraps only the title, but its ::before overlay
	   extends the clickable area across the whole .card. */
	.card-titulo a {
		text-decoration: none;
		color: inherit;
	}
	.card-titulo a::before {
		content: "";
		position: absolute;
		inset: 0;
	}
	.card:has(.card-titulo a:hover) .card-titulo,
	.card:has(.card-titulo a:focus-visible) .card-titulo {
		color: var(--color-oro-texto);
	}

	.card-autor {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	.card-fecha {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		margin: var(--space-2xs) 0 0;
	}
</style>