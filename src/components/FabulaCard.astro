---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import OrnamentoTarjeta from './ornaments/OrnamentoTarjeta.astro';

interface Props {
	fabula: CollectionEntry<'fabulas'>;
	autorNombre: string;
	destacada?: boolean;
}

const { fabula, autorNombre, destacada = false } = Astro.props;
const { titulo, ilustracion, fecha } = fabula.data;

// Astro:assets hints. Larger for the featured card since it spans full width.
const imgWidth = destacada ? 1200 : 900;
const imgHeight = destacada ? 800 : 600;
---

<article class:list={['card', { 'card-destacada': destacada }]}>
	<a href={`/fabulas/${fabula.id}/`} class="card-link">
		<figure class:list={['card-img', { 'con-ornamento': !ilustracion }]}>
			{ilustracion ? (
				<Image
					width={imgWidth}
					height={imgHeight}
					src={ilustracion}
					alt=""
					loading="lazy"
				/>
			) : (
				<OrnamentoTarjeta />
			)}
		</figure>
		<div class="card-meta">
			<h3 class="card-titulo">{titulo}</h3>
			<p class="card-autor">por {autorNombre}</p>
			<p class="card-fecha">
				<FormattedDate date={fecha} />
			</p>
		</div>
	</a>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
	}
	.card-destacada {
		text-align: center;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		flex: 1;
		text-decoration: none;
		color: inherit;
	}

	/* Frame: aspect ratio shared by both image and ornament variants */
	.card-img {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		margin: 0 0 var(--space-md);
	}

	/* Ornament variant: double gold border, replicates the canonical .frame */
	.card-img.con-ornamento {
		position: relative;
		background: #EADDC0; /* slightly shaded marfil, candidate token --color-marfil-shade */
		border: var(--rule-medium) solid var(--color-oro);
	}
	.card-img.con-ornamento::before {
		content: "";
		position: absolute;
		inset: 6px;
		border: var(--rule-hairline) solid var(--color-oro);
		pointer-events: none;
	}

	.card-destacada .card-img {
		max-width: var(--measure-wide);
		margin-inline: auto;
		margin-bottom: var(--space-lg);
	}

	.card-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.card-img :global(svg.ornamento) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.card-link:hover .card-img :global(img),
	.card-link:focus-visible .card-img :global(img) {
		transform: scale(1.02);
	}

	.card-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}
	.card-destacada .card-titulo {
		font-size: var(--fs-2xl);
		text-transform: uppercase;
		letter-spacing: var(--ls-wider);
	}
	.card-link:hover .card-titulo,
	.card-link:focus-visible .card-titulo {
		color: var(--color-oro-texto);
	}

	.card-autor {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	.card-fecha {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		margin: var(--space-2xs) 0 0;
	}
</style>