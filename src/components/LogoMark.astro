---
// Rombo de El Fabulario. Reutilizable como brand mark en cabecera (76px)
// y como ornamento central en la navegación entre fábulas (56px).
// Decorativo por defecto (aria-hidden): cuando va dentro de un enlace,
// el `aria-label` del enlace contenedor es quien comunica al lector de
// pantalla.
interface Props {
  width?: string | number;
  class?: string;
}
const { width = 76, class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={width}
  height={width}
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <polygon points="100,10 190,100 100,190 10,100" fill="var(--color-oro)" />
  <polygon points="100,16 184,100 100,184 16,100" fill="#0F1B3D" />
  <polygon points="100,24 176,100 100,176 24,100" fill="var(--color-oro)" />
  <polygon points="100,27 173,100 100,173 27,100" fill="#0F1B3D" />
  <path d="M 80 58 L 122 58 L 122 73 L 95 73 L 95 92 L 113 92 L 113 106 L 95 106 L 95 144 L 80 144 Z" fill="var(--color-oro)" />
</svg>

<style>
  .logo-mark {
    display: block;
  }
</style>