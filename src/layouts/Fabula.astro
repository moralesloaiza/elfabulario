---
import { Image } from 'astro:assets';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import HeroInmersivo from '../components/HeroInmersivo.astro';
import IconoEditar from '../components/IconoEditar.astro';
import NavegacionFabulas from '../components/NavegacionFabulas.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import { marked } from 'marked';
import {
	PERSONAJES_DISPLAY,
	TEMAS_DISPLAY,
	FORMAS_DISPLAY,
	TRADICIONES_DISPLAY,
	URL_PERSONAJES,
	URL_TEMAS,
} from '../utils/taxonomia';

import JsonLd from '../components/JsonLd.astro';
import { buildFabulaJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';

type Props = CollectionEntry<'fabulas'>['data'] & {
	id: string;
	/** Minutos de lectura, ya calculados en la página (el layout no ve el body). */
	minutosLectura: number;
};

const {
	id,
	titulo,
	resumen,
	autor,
	curador,
	nota_curador,
	fecha,
	fecha_actualizada,
	ilustracion,
	credito_ilustracion,
	foco,
	personajes,
	temas,
	forma,
	tradicion,
	spotify_url,
	traduccion,
	traductor,
	moraleja,
	minutosLectura,
} = Astro.props;

// `autor` es una reference('autores') validada por Zod en build, así que el
// archivo siempre existe. Resolvemos la entrada y leemos los datos
// biográficos desde ahí, en lugar de duplicarlos en el frontmatter de fábula.
const autorEntry = await getEntry(autor);
if (!autorEntry) throw new Error(`Author entry not found for fábula "${id}"`);

const autorNombre = autorEntry.data.nombre;
const autorHref = `/autores/${autorEntry.id}/`;

// Traductor: referencia opcional a `autores`. Solo se resuelve si la ficha
// es traducción y hay traductor seleccionado. Si `traduccion` es true sin
// ficha, el crédito cae al string `curador`.
const traductorEntry = traduccion && traductor ? await getEntry(traductor) : undefined;

// Datos biográficos del autor para la ficha lateral y el origen.
const {
	nacionalidad,
	nacimiento,
	muerte,
	siglo,
	imagen: autorImagen,
	foco: autorFoco,
	descripcion: autorDescripcion,
} = autorEntry.data;

const epocaAutor =
	nacimiento && muerte
		? `${nacimiento} — ${muerte}`
		: siglo
			? `siglo ${siglo}`
			: null;

// Glosa breve del autor para la ficha lateral: la descripción canónica si
// existe; si no, el primer párrafo de la bio (limpiando énfasis y enlaces).
function primerParrafo(md: string | undefined): string | undefined {
	if (!md) return undefined;
	const parrafo = md.trim().split(/\n\s*\n/)[0] ?? '';
	const limpio = parrafo
		.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
		.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
		.replace(/\*\*([^*]+)\*\*/g, '$1')
		.replace(/\*([^*]+)\*/g, '$1')
		.replace(/_([^_]+)_/g, '$1')
		.replace(/`([^`]+)`/g, '$1')
		.replace(/\s+/g, ' ')
		.trim();
	return limpio || undefined;
}
const glosaAutor = autorDescripcion ?? primerParrafo(autorEntry.body);

// Línea de metadatos de la ficha: origen · forma · lectura · crédito.
// "Origen" = tradición fabulística si la hay; si no, la nacionalidad del autor.
const origen = tradicion ? TRADICIONES_DISPLAY[tradicion] : nacionalidad;
const metadatos = [
	origen,
	FORMAS_DISPLAY[forma],
	`Lectura ${minutosLectura} min`,
	credito_ilustracion ? `Ilustración de ${credito_ilustracion}` : null,
].filter(Boolean) as string[];

// Todas las fábulas publicadas: recuento por autor, navegación y "Seguir leyendo".
const todasLasFabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

const fabulasDelAutor = todasLasFabulas.filter(
	(f) => f.data.autor.id === autorEntry.id,
).length;

const verFabulasTexto =
	fabulasDelAutor <= 1
		? 'Ver su fábula →'
		: `Ver sus ${fabulasDelAutor} fábulas →`;

// Navegación entre fábulas: orden cronológico descendente (más reciente primero),
// con `id` como desempate determinista para fechas idénticas. Loop en los extremos:
// la primera enlaza con la última como "anterior", y viceversa.
const fabulasOrdenadas = [...todasLasFabulas].sort((a, b) => {
	const diff = b.data.fecha.getTime() - a.data.fecha.getTime();
	if (diff !== 0) return diff;
	return a.id.localeCompare(b.id);
});
const indiceActual = fabulasOrdenadas.findIndex((f) => f.id === id);
const total = fabulasOrdenadas.length;
const fabulaAnterior = fabulasOrdenadas[(indiceActual - 1 + total) % total];
const fabulaSiguiente = fabulasOrdenadas[(indiceActual + 1) % total];

// "Seguir leyendo": tres fábulas, primero las del mismo autor, luego el resto
// (cronológico). Cada una muestra "Autor · Forma".
const otras = fabulasOrdenadas.filter((f) => f.id !== id);
const seguirLeyendo = [
	...otras.filter((f) => f.data.autor.id === autorEntry.id),
	...otras.filter((f) => f.data.autor.id !== autorEntry.id),
]
	.slice(0, 3)
	.map((f) => ({
		id: f.id,
		titulo: f.data.titulo,
		autorNombre: autoresPorId.get(f.data.autor.id) ?? '',
		formaDisplay: FORMAS_DISPLAY[f.data.forma],
	}));

const notaHtml = nota_curador
	? marked.parse(nota_curador, { breaks: true })
	: null;
const notaTitulo = traduccion ? 'Nota del traductor' : 'Nota del curador';

// Structured data (JSON-LD ShortStory). Lives in <head>, near BaseHead.
const jsonLd = buildFabulaJsonLd(Astro.props, autorEntry, Astro.site!, traductorEntry);
const breadcrumbLd = buildBreadcrumbJsonLd(
	[
		{ name: 'Inicio', path: '/' },
		{ name: 'Fábulas', path: '/fabulas/' },
		{ name: titulo, path: `/fabulas/${id}/` },
	],
	Astro.site!,
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={titulo}
			description={resumen ?? titulo}
			image={ilustracion}
			imageAlt={ilustracion ? `Ilustración de "${titulo}"` : undefined}
			type="article"
			publishedTime={fecha}
			modifiedTime={fecha_actualizada}
			author={autorNombre}
		/>

		<JsonLd data={jsonLd} />
		<JsonLd data={breadcrumbLd} />
	</head>

	<body>
		<Header />
		<main class="fabula" data-pagefind-body>
			{/* 1 · Ilustración a sangre 8:3 (foco) + filete doble. Sin texto encima. */}
			{ilustracion && (
				<HeroInmersivo
					imagen={ilustracion}
					alt={`Ilustración de "${titulo}"`}
					foco={foco}
					minAltura="420px"
				/>
			)}

			{/* 2 · Encabezado: migas, H1, byline y línea de metadatos. */}
			<header class="encabezado page">
				<nav class="migas" aria-label="Ruta de navegación">
					<a href="/fabulas/">Fábulas</a>
					<span class="migas-sep" aria-hidden="true">·</span>
					<a href={autorHref}>{autorNombre}</a>
					<span class="migas-sep" aria-hidden="true">·</span>
					<span class="migas-actual" aria-current="page">{titulo}</span>
				</nav>

				<h1>{titulo}</h1>

				<p class="byline">
					por
					<a href={autorHref}><span data-pagefind-meta="author">{autorNombre}</span></a>
				</p>

				<p class="metadatos">
					{metadatos.map((m, i) => (
						<>
							{i > 0 && <span class="metadatos-sep" aria-hidden="true">·</span>}
							<span>{m}</span>
						</>
					))}
				</p>
			</header>

			{/* 3 · Narración: eyebrow + embed real de Spotify. */}
			{spotify_url && (
				<section class="narracion page" aria-label="Narración en Spotify">
					<p class="eyebrow">Narración · Spotify</p>
					<SpotifyEmbed url={spotify_url} />
				</section>
			)}

			{/* 4 · Cuerpo a dos columnas: artículo + aside sticky. */}
			<div class="cuerpo page">
				<article class="articulo">
					<div class:list={['prose', forma === 'verso' && 'prose--verso']}>
						<slot />
					</div>

					{moraleja && (
						<div class="moraleja">
							<p class="eyebrow">Moraleja</p>
							<p class="moraleja-frase">{moraleja}</p>
						</div>
					)}

					{notaHtml && (
						<aside class="nota-curador" aria-label={notaTitulo}>
							<p class="eyebrow">{notaTitulo}</p>
							<div class="nota-curador-cuerpo" set:html={notaHtml} />
						</aside>
					)}

					{(temas.length > 0 || personajes.length > 0) && (
						<div class="clasificacion">
							{temas.length > 0 && (
								<div class="chips-grupo">
									<span class="chips-rotulo">Temas</span>
									<ul class="chips">
										{temas.map((t) => (
											<li>
												<a class="chip" href={`${URL_TEMAS}/${t}/`}>{TEMAS_DISPLAY[t]}</a>
											</li>
										))}
									</ul>
								</div>
							)}
							{personajes.length > 0 && (
								<div class="chips-grupo">
									<span class="chips-rotulo">Personajes</span>
									<ul class="chips">
										{personajes.map((p) => (
											<li>
												<a class="chip" href={`${URL_PERSONAJES}/${p}/`}>{PERSONAJES_DISPLAY[p]}</a>
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					)}
				</article>

				<aside class="sidebar">
					{/* Ficha del autor */}
					<div class="ficha-autor">
						<p class="eyebrow">El autor</p>
						<div class="ficha-autor-cabecera">
							{autorImagen && (
								<div class="ficha-autor-retrato">
									<Image
										src={autorImagen}
										alt={`Retrato de ${autorNombre}`}
										width={252}
										height={168}
										style={`object-position: 50% ${autorFoco ?? 15}%`}
									/>
								</div>
							)}
							<div>
								<a class="ficha-autor-nombre" href={autorHref}>{autorNombre}</a>
								{epocaAutor && <p class="ficha-autor-fechas">{epocaAutor}</p>}
							</div>
						</div>
						{glosaAutor && <p class="ficha-autor-glosa">{glosaAutor}</p>}
						<a class="ficha-autor-enlace" href={autorHref}>{verFabulasTexto}</a>
					</div>

					{/* Seguir leyendo */}
					{seguirLeyendo.length > 0 && (
						<nav class="seguir" aria-label="Seguir leyendo">
							<p class="eyebrow">Seguir leyendo</p>
							<ul>
								{seguirLeyendo.map((f) => (
									<li>
										<a href={`/fabulas/${f.id}/`}>
											<span class="seguir-titulo">{f.titulo}</span>
											<span class="seguir-meta">{[f.autorNombre, f.formaDisplay].filter(Boolean).join(' · ')}</span>
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}
				</aside>
			</div>

			{/* Cierre editorial: crédito de curaduría/traducción + fechas. */}
			<div class="cierre page">
				{traduccion ? (
					<p class="curaduria">
						Esta fábula ha sido traducida al español por{' '}
						{traductorEntry ? (
							<a href={`/autores/${traductorEntry.id}/`}><strong>{traductorEntry.data.nombre}</strong></a>
						) : (
							<strong>{curador}</strong>
						)}.
					</p>
				) : (
					curador && (
						<p class="curaduria">
							Esta fábula la trae a El Fabulario <strong>{curador}</strong>.
						</p>
					)
				)}
				<p class="meta-fechas">
					Publicada el <FormattedDate date={fecha} />
					{fecha_actualizada && (
						<span class="meta-fechas-actualizada">
							{' · '}actualizada el <FormattedDate date={fecha_actualizada} />
						</span>
					)}
				</p>
				<p class="utilidades">
					{traduccion && (
						<>
							<a href="/traducciones/">Ver todas las traducciones</a>
							<span class="utilidades-sep" aria-hidden="true">·</span>
						</>
					)}
					<a href="/colaborar/">Sugiere otra fábula</a>
				</p>
			</div>

			{total > 1 && (
				<div class="page">
					<NavegacionFabulas
						anterior={{ slug: fabulaAnterior.id, titulo: fabulaAnterior.data.titulo }}
						siguiente={{ slug: fabulaSiguiente.id, titulo: fabulaSiguiente.data.titulo }}
					/>
				</div>
			)}
		</main>
		<Footer />
		<IconoEditar slug={id} />
	</body>
</html>

<style>
	.fabula {
		padding-bottom: clamp(3.5rem, 7vw, 6.25rem);
	}

	/* ── Eyebrow compartido (Cinzel pequeño, oro legible) ─────────────────── */
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}

	/* ── 2 · Encabezado ───────────────────────────────────────────────────── */
	.encabezado {
		padding-top: clamp(1.875rem, 4vw, 3.375rem);
	}
	.migas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-sm);
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
	}
	.migas a {
		color: var(--color-zafiro);
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.migas a:hover,
	.migas a:focus-visible {
		border-bottom-color: var(--color-zafiro);
	}
	.migas-sep {
		color: var(--color-oro);
	}
	.migas-actual {
		color: var(--color-text-soft);
	}
	.encabezado h1 {
		margin: var(--space-lg) 0 0;
		font-family: var(--font-display);
		font-weight: var(--fw-semibold);
		font-size: var(--fs-3xl);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-wide);
		text-transform: uppercase;
		text-wrap: balance;
		color: var(--color-text);
	}
	.byline {
		margin: var(--space-md) 0 0;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-esmeralda);
	}
	.byline a {
		color: inherit;
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.byline a:hover,
	.byline a:focus-visible {
		border-bottom-color: var(--color-esmeralda);
	}
	.metadatos {
		margin: var(--space-lg) 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2xs) var(--space-xs);
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		color: var(--color-oro-texto);
	}
	.metadatos-sep {
		color: var(--color-oro);
	}

	/* ── 3 · Narración (Spotify) ──────────────────────────────────────────── */
	.narracion {
		padding-top: clamp(1.625rem, 3vw, 2.5rem);
	}
	.narracion .eyebrow {
		margin-bottom: var(--space-sm);
	}
	.narracion :global(.spotify-embed) {
		max-width: 640px;
		margin-block: 0;
	}

	/* ── 4 · Cuerpo a dos columnas ────────────────────────────────────────── */
	.cuerpo {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(var(--space-xl), 5vw, 4.5rem);
		padding-top: clamp(2.5rem, 5vw, 4.5rem);
	}
	.articulo {
		flex: 1 1 520px;
		max-width: 720px;
		min-width: 0;
	}
	/* El artículo ya acota la medida (720px); la prosa llena su columna. */
	.articulo .prose {
		max-width: none;
	}

	/* Cuerpo de lectura: 20px / 1.75 (Cormorant). */
	.articulo .prose :global(p) {
		font-size: 1.25rem;
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
		hyphens: auto;
	}
	.articulo .prose:not(.prose--verso) :global(p:first-of-type)::first-letter {
		font-family: var(--font-display);
		font-size: 3.8em;
		float: left;
		line-height: 0.82;
		padding-right: 0.09em;
		padding-top: 0.02em;
		color: var(--color-oro-texto);
	}
	/* Verso: bloque centrado, con respiro izquierdo en móvil. */
	.articulo .prose--verso {
		width: max-content;
		max-width: 100%;
		margin-inline: auto;
	}

	/* Cita destacada (blockquote del Markdown): filetes oro, cursiva zafiro.
	   Anula el max-width estrecho global de `.prose blockquote`. */
	.articulo :global(blockquote) {
		max-width: none;
		margin: clamp(1.75rem, 3vw, 2.125rem) 0;
		padding: clamp(1.375rem, 3vw, 1.625rem) clamp(1.375rem, 3vw, 2.25rem);
		border-top: var(--rule-thin) solid var(--color-oro);
		border-bottom: var(--rule-thin) solid var(--color-oro);
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-xl);
		line-height: var(--lh-snug);
		color: var(--color-zafiro);
	}
	.articulo :global(blockquote p) {
		margin: 0;
		font-size: inherit;
		line-height: inherit;
	}

	/* Caja de moraleja: filete oro + frase en cursiva. */
	.moraleja {
		margin-top: clamp(2.25rem, 4vw, 3.5rem);
		padding: clamp(var(--space-lg), 3vw, 2.25rem);
		border: var(--rule-thin) solid var(--color-oro);
	}
	.moraleja-frase {
		margin: var(--space-md) 0 0;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-xl);
		line-height: 1.45;
		color: var(--color-text);
	}

	/* Nota editorial del curador/traductor. */
	.nota-curador {
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-top: var(--space-lg);
		border-top: var(--rule-hairline) solid var(--color-oro);
	}
	.nota-curador .eyebrow {
		margin-bottom: var(--space-md);
	}
	.nota-curador-cuerpo :global(p),
	.nota-curador-cuerpo :global(li) {
		font-family: var(--font-body);
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
	}
	.nota-curador-cuerpo :global(p) {
		margin-bottom: var(--space-sm);
	}
	.nota-curador-cuerpo :global(p:last-child) {
		margin-bottom: 0;
	}
	.nota-curador-cuerpo :global(ol),
	.nota-curador-cuerpo :global(ul) {
		margin: 0 0 var(--space-sm);
		padding-left: var(--space-lg);
	}
	.nota-curador-cuerpo :global(li) {
		margin-bottom: var(--space-xs);
	}
	.nota-curador-cuerpo :global(em) {
		font-style: italic;
	}
	.nota-curador-cuerpo :global(strong) {
		font-weight: var(--fw-semibold);
	}

	/* Clasificación: chips de temas (y personajes) al pie del artículo. */
	.clasificacion {
		margin-top: clamp(2rem, 4vw, 3rem);
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}
	.chips-grupo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm) var(--space-md);
	}
	.chips-rotulo {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		flex-shrink: 0;
		min-width: 6rem;
	}
	.chips {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-sm);
	}
	/* Pastilla inactiva (mismo estilo que el listado): borde oro, texto zafiro. */
	.chip {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-zafiro);
		text-decoration: none;
		padding: var(--space-xs) var(--space-md);
		border: var(--rule-thin) solid rgba(201, 161, 74, 0.7);
