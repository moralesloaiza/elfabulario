---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';
import { slugify } from '../utils/slug';

type Props = CollectionEntry<'fabulas'>['data'];

const {
	titulo,
	resumen,
	autor,
	autor_nacionalidad,
	autor_nacimiento,
	autor_muerte,
	autor_siglo,
	curador,
	fecha,
	fecha_actualizada,
	ilustracion,
	etiquetas,
} = Astro.props;

// Resolvemos el slug del archivo de autor (si existe) buscando por nombre
// exacto. Si no hay match, el nombre se renderiza como texto plano sin enlace.
const autoresColeccion = await getCollection('autores');
const autorEntry = autoresColeccion.find((a) => a.data.nombre === autor);
const autorHref = autorEntry ? `/autores/${autorEntry.id}/` : null;

// Construye una línea secundaria con nacionalidad y época del autor.
// Ej.: "español · 1745–1801"  o  "griego · siglo VI a.C."
const epoca =
	autor_nacimiento && autor_muerte
		? `${autor_nacimiento}–${autor_muerte}`
		: autor_siglo
			? `siglo ${autor_siglo}`
			: null;
const datosAutor = [autor_nacionalidad, epoca].filter(Boolean).join(' · ');
---

<html lang="es">
	<head>
		<BaseHead title={titulo} description={resumen ?? titulo} />
	</head>

	<body>
		<Header />
		<main class="page">
			<article class="fabula">
				{ilustracion && (
					<figure class="hero-image">
						<Image width={1200} height={800} src={ilustracion} alt="" />
					</figure>
				)}

				<header class="title">
					<Sol width="80px" />

					<h1>{titulo}</h1>

					{resumen && <p class="resumen">{resumen}</p>}

					<p class="autor">
						por
						{autorHref ? (
							<a href={autorHref}><span>{autor}</span></a>
						) : (
							<span>{autor}</span>
						)}
					</p>
					{datosAutor && <p class="autor-meta">{datosAutor}</p>}

					<p class="fecha">
						<FormattedDate date={fecha} />
						{fecha_actualizada && (
							<span class="actualizada">
								· actualizada el <FormattedDate date={fecha_actualizada} />
							</span>
						)}
					</p>
				</header>

				<hr class="ornate" />

				<div class="prose">
					<slot />
				</div>

				{curador && (
					<p class="curaduria">
						Esta fábula la trae al Fabulario <strong>{curador}</strong>.
					</p>
				)}

				{etiquetas && etiquetas.length > 0 && (
					<footer class="etiquetas" aria-label="Etiquetas">
						{etiquetas.map((e) => (
							<a class="etiqueta" href={`/etiquetas/${slugify(e)}/`}>#{e}</a>
						))}
					</footer>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.fabula {
		max-width: var(--measure);
		margin-inline: auto;
		padding-block: var(--space-2xl);
	}
	.hero-image {
		margin: 0 0 var(--space-2xl);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: var(--rule-hairline) solid var(--color-oro);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-xl);
	}
	.title h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.resumen {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-md);
	}
	/* "por NOMBRE DEL AUTOR" — más pequeño que el título, en versalitas */
	.autor {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-oro-texto);
		margin: 0;
	}
	.autor span {
		font-weight: var(--fw-bold);
	}
	.autor a {
		color: inherit;
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.autor a:hover,
	.autor a:focus-visible {
		border-bottom-color: var(--color-oro-texto);
	}
	/* nacionalidad · años, en cursiva discreta debajo del autor */
	.autor-meta {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: var(--space-3xs) 0 0;
	}
	.fecha {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: var(--space-2xs) 0 0;
	}
	.actualizada {
		font-style: italic;
	}
	.prose :global(p) {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
		hyphens: auto;
	}
	.prose :global(p:first-of-type)::first-letter {
		font-family: var(--font-display);
		font-size: 3.5em;
		float: left;
		line-height: 0.85;
		padding-right: 0.08em;
		padding-top: 0.05em;
		color: var(--color-oro-texto);
	}
	/* Pie discreto con la firma del curador */
	.curaduria {
		text-align: center;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin-top: var(--space-2xl);
		padding-top: var(--space-md);
		border-top: var(--rule-hairline) solid var(--color-oro);
	}
	.curaduria strong {
		font-style: normal;
		color: var(--color-text);
	}
	.etiquetas {
		margin-top: var(--space-xl);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		justify-content: center;
	}
	.etiqueta {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		color: var(--color-esmeralda);
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.etiqueta:hover,
	.etiqueta:focus-visible {
		border-bottom-color: var(--color-esmeralda);
	}
</style>
