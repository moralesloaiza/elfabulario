---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';

type Props = CollectionEntry<'fabulas'>['data'];

const { titulo, resumen, autor, fecha, fecha_actualizada, ilustracion, etiquetas } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={titulo} description={resumen} />
	</head>

	<body>
		<Header />
		<main class="page">
			<article class="fabula">
				{ilustracion && (
					<figure class="hero-image">
						<Image width={1200} height={600} src={ilustracion} alt="" />
					</figure>
				)}

				<header class="title">
					<Sol width="80px" />

					<h1>{titulo}</h1>

					{resumen && <p class="resumen">{resumen}</p>}

					<p class="autor">por <span>{autor}</span></p>
					<p class="fecha">
						<FormattedDate date={fecha} />
						{fecha_actualizada && (
							<span class="actualizada">
								· actualizada el <FormattedDate date={fecha_actualizada} />
							</span>
						)}
					</p>
				</header>

				<hr class="ornate" />

				<div class="prose">
					<slot />
				</div>

				{etiquetas && etiquetas.length > 0 && (
					<footer class="etiquetas" aria-label="Etiquetas">
						{etiquetas.map((e) => (
							<span class="etiqueta">#{e}</span>
						))}
					</footer>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.fabula {
		max-width: var(--measure);
		margin-inline: auto;
		padding-block: var(--space-2xl);
	}
	.hero-image {
		margin: 0 0 var(--space-2xl);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: var(--rule-hairline) solid var(--color-oro);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-xl);
	}
	.title h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.resumen {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-md);
	}
	.autor {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}
	.autor span {
		font-weight: var(--fw-bold);
	}
	.fecha {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: var(--space-2xs) 0 0;
	}
	.actualizada {
		font-style: italic;
	}
	.prose :global(p) {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
		hyphens: auto;
	}
	.prose :global(p:first-of-type)::first-letter {
		font-family: var(--font-display);
		font-size: 3.5em;
		float: left;
		line-height: 0.85;
		padding-right: 0.08em;
		padding-top: 0.05em;
		color: var(--color-oro-texto);
	}
	.etiquetas {
		margin-top: var(--space-2xl);
		padding-top: var(--space-md);
		border-top: var(--rule-hairline) solid var(--color-oro);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}
	.etiqueta {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		text-transform: uppercase;
		color: var(--color-esmeralda);
	}
</style>
