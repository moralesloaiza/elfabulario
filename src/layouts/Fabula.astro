---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'fabulas'>['data'];

const { titulo, resumen, autor, fecha, fecha_actualizada, ilustracion, etiquetas } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={titulo} description={resumen} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.1;
			}
			.title h1 {
				margin: 0 0 0.25em 0;
			}
			.autor {
				margin: 0 0 0.5em 0;
				font-style: italic;
				color: rgb(var(--gray));
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.etiquetas {
				margin-top: 2em;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.etiqueta {
				display: inline-block;
				margin-right: 0.5em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{ilustracion && <Image width={1020} height={510} src={ilustracion} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{titulo}</h1>
						<p class="autor">por {autor}</p>
						<div class="date">
							<FormattedDate date={fecha} />
							{
								fecha_actualizada && (
									<div class="last-updated-on">
										Actualizada el <FormattedDate date={fecha_actualizada} />
									</div>
								)
							}
						</div>
						<hr />
					</div>
					<slot />
					{etiquetas.length > 0 && (
						<div class="etiquetas">
							{etiquetas.map((e) => (
								<span class="etiqueta">#{e}</span>
							))}
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
