---
import { Image } from 'astro:assets';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import IconoEditar from '../components/IconoEditar.astro';
import NavegacionFabulas from '../components/NavegacionFabulas.astro';
import { slugify } from '../utils/slug';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import { marked } from 'marked';
import {
	PERSONAJES_DISPLAY,
	TEMAS_DISPLAY,
	FORMAS_DISPLAY,
	TRADICIONES_DISPLAY,
	URL_PERSONAJES,
	URL_TEMAS,
	URL_FORMAS,
	URL_TRADICIONES,
} from '../utils/taxonomia';

import JsonLd from '../components/JsonLd.astro';
import { buildFabulaJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';

type Props = CollectionEntry<'fabulas'>['data'] & { id: string };

const {
	id,
	titulo,
	resumen,
	autor,
	curador,
	nota_curador,
	fecha,
	fecha_actualizada,
	ilustracion,
	personajes,
	temas,
	forma,
	tradicion,
	spotify_url,
} = Astro.props;

// `autor` es una reference('autores') validada por Zod en build, así que el
// archivo siempre existe. Resolvemos la entrada y leemos los datos
// biográficos desde ahí, en lugar de duplicarlos en el frontmatter de fábula.
const autorEntry = await getEntry(autor);
if (!autorEntry) throw new Error(`Author entry not found for fábula "${id}"`);

const autorNombre = autorEntry.data.nombre;
const autorHref = `/autores/${autorEntry.id}/`;

// Línea secundaria con nacionalidad y época. Ej.: "español · 1745–1801".
const { nacionalidad, nacimiento, muerte, siglo } = autorEntry.data;
const epoca =
	nacimiento && muerte
		? `${nacimiento}–${muerte}`
		: siglo
			? `siglo ${siglo}`
			: null;
const datosAutor = [nacionalidad, epoca].filter(Boolean).join(' · ');

// Count published fables by the same author to decide the AUTHOR link target.
// Below the threshold the corpus is too thin to send the reader to the author
// page; we fall back to the general index. "Anónimo" gets a special string
// so the link reads naturally as an adjective ("anónimas") rather than a name.

const todasLasFabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
const fabulasDelAutor = todasLasFabulas.filter(
	(f) => f.data.autor.id === autorEntry.id,
).length;

const ENLACE_AUTOR_UMBRAL = 3;
const autorEnlaceHref =
	fabulasDelAutor >= ENLACE_AUTOR_UMBRAL ? autorHref : '/fabulas/';
const autorEnlaceTexto =
	fabulasDelAutor < ENLACE_AUTOR_UMBRAL
		? 'Otras fábulas'
		: autorNombre === 'Anónimo'
			? 'Más fábulas anónimas'
			: `Más fábulas de ${autorNombre}`;
// Navegación entre fábulas: orden cronológico descendente (más reciente primero),
// con `id` como desempate determinista para fechas idénticas. Loop en los extremos:
// la primera enlaza con la última como "anterior", y viceversa.
const fabulasOrdenadas = [...todasLasFabulas].sort((a, b) => {
	const diff = b.data.fecha.getTime() - a.data.fecha.getTime();
	if (diff !== 0) return diff;
	return a.id.localeCompare(b.id);
});
const indiceActual = fabulasOrdenadas.findIndex((f) => f.id === id);
const total = fabulasOrdenadas.length;
const fabulaAnterior = fabulasOrdenadas[(indiceActual - 1 + total) % total];
const fabulaSiguiente = fabulasOrdenadas[(indiceActual + 1) % total];
const notaHtml = nota_curador
	? marked.parse(nota_curador, { breaks: true })
	: null;

// Structured data (JSON-LD ShortStory). Lives in <head>, near BaseHead.
const jsonLd = buildFabulaJsonLd(Astro.props, autorEntry, Astro.site!);
const breadcrumbLd = buildBreadcrumbJsonLd(
	[
		{ name: 'Inicio', path: '/' },
		{ name: 'Fábulas', path: '/fabulas/' },
		{ name: titulo, path: `/fabulas/${id}/` },
	],
	Astro.site!,
);

---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={titulo}
			description={resumen ?? titulo}
			image={ilustracion}
			imageAlt={ilustracion ? `Ilustración de "${titulo}"` : undefined}
			type="article"
			publishedTime={fecha}
			modifiedTime={fecha_actualizada}
			author={autorNombre}
		/>

<JsonLd data={jsonLd} />
<JsonLd data={breadcrumbLd} />

	</head>

	<body>
		<Header />
		<main class="page">
			<article class="fabula" data-pagefind-body>
				{ilustracion && (
					<figure class="hero-image">
						<Image width={1200} height={800} src={ilustracion} alt="" />
					</figure>
				)}

				<header class="title">
					<h1>{titulo}</h1>
					{resumen && <p class="resumen">{resumen}</p>}
					<p class="autor">
						por
						<a href={autorHref}><span data-pagefind-meta="author">{autorNombre}</span></a>
					</p>
					{datosAutor && <p class="autor-meta">{datosAutor}</p>}
				</header>

				<hr class="ornate" />

				{spotify_url && (
					<>
						<SpotifyEmbed url={spotify_url} />
						<hr class="ornate" />
					</>
				)}

<div class:list={['prose', forma === 'verso' && 'prose--verso']}>
  			<slot />
		</div>

		{notaHtml && (
			<aside class="nota-curador" aria-label="Nota del curador">
				<h2 class="nota-curador-titulo">Nota del curador</h2>
				<div class="nota-curador-cuerpo" set:html={notaHtml} />
			</aside>
		)}

		<div class="cierre">
			{curador && (
				<p class="curaduria">
					Esta fábula la trae a El Fabulario <strong>{curador}</strong>.
				</p>
			)}
			<p class="meta-fechas">
				Publicada el <FormattedDate date={fecha} />
				{fecha_actualizada && (
					<span class="meta-fechas-actualizada">
						{' · '}actualizada el <FormattedDate date={fecha_actualizada} />
					</span>
				)}
			</p>
		</div>

		{total > 1 && (
			<NavegacionFabulas
				anterior={{ slug: fabulaAnterior.id, titulo: fabulaAnterior.data.titulo }}
				siguiente={{ slug: fabulaSiguiente.id, titulo: fabulaSiguiente.data.titulo }}
			/>
		)}

<footer class="taxonomia" aria-label="Clasificación de la fábula">
					{personajes.length > 0 && (
						<div class="taxonomia-grupo">
							<span class="taxonomia-rotulo">Personajes</span>
							<ul class="taxonomia-lista">
								{personajes.map((p) => (
									<li>
										<a href={`${URL_PERSONAJES}/${p}/`}>
											{PERSONAJES_DISPLAY[p]}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					{temas.length > 0 && (
						<div class="taxonomia-grupo">
							<span class="taxonomia-rotulo">Temas</span>
							<ul class="taxonomia-lista">
								{temas.map((t) => (
									<li>
										<a href={`${URL_TEMAS}/${t}/`}>
											{TEMAS_DISPLAY[t]}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					{forma && (
						<div class="taxonomia-grupo">
							<span class="taxonomia-rotulo">Forma</span>
							<ul class="taxonomia-lista">
								<li>
									<a href={`${URL_FORMAS}/${forma}/`}>
										{FORMAS_DISPLAY[forma]}
									</a>
								</li>
							</ul>
						</div>
					)}

					{tradicion && (
						<div class="taxonomia-grupo">
							<span class="taxonomia-rotulo">Tradición</span>
							<ul class="taxonomia-lista">
								<li>
									<a href={`${URL_TRADICIONES}/${tradicion}/`}>
										{TRADICIONES_DISPLAY[tradicion]}
									</a>
								</li>
							</ul>
						</div>
					)}

					<div class="taxonomia-grupo">
						<span class="taxonomia-rotulo">Autor</span>
						<ul class="taxonomia-lista">
							<li>
								<a href={autorEnlaceHref}>{autorEnlaceTexto}</a>
							</li>
						</ul>
					</div>

					<div class="taxonomia-grupo">
						<span class="taxonomia-rotulo">Ayuda</span>
						<ul class="taxonomia-lista">
							<li>
								<a href="/colaborar/">Sugiere otra fábula</a>
							</li>
						</ul>
					</div>
				</footer>
			</article>
		</main>
		<Footer />
		<IconoEditar slug={id} />
	</body>
</html>

<style>
	.fabula {
		max-width: var(--measure);
		margin-inline: auto;
		padding-block: var(--space-2xl);
	}
	.hero-image {
		margin: 0 0 var(--space-2xl);
	}
.hero-image :global(img) {
	display: block;
	width: 100%;
	height: auto;
}
	.title {
		text-align: center;
		margin-bottom: var(--space-xl);
	}
	.title h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.resumen {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-md);
	}
	/* "por NOMBRE DEL AUTOR" — más pequeño que el título, en versalitas */
	.autor {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-oro-texto);
		margin: 0;
	}
	.autor span {
		font-weight: var(--fw-bold);
	}
	.autor a {
		color: inherit;
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.autor a:hover,
	.autor a:focus-visible {
		border-bottom-color: var(--color-oro-texto);
	}
	/* nacionalidad · años, en cursiva discreta debajo del autor */
	.autor-meta {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: var(--space-3xs) 0 0;
	}
	.prose :global(p) {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
		hyphens: auto;
	}
	.prose:not(.prose--verso) :global(p:first-of-type)::first-letter {
		font-family: var(--font-display);
		font-size: 3.5em;
		float: left;
		line-height: 0.85;
		padding-right: 0.08em;
		padding-top: 0.05em;
		color: var(--color-oro-texto);
	}
	/* Verso: bloque centrado, con respiro izquierdo en móvil */
	.prose--verso {
  		width: max-content;
  		max-width: 100%;
  		margin-inline: auto;
	}
	@media (max-width: 40rem) {
  	.prose--verso {
    		padding-inline-start: var(--space-md); /* 16px */
  	}
	}
	/* Bloque de cierre: firma del curador + fechas de publicación.
	   Ambos párrafos quedan visualmente agrupados como una unidad
	   de metadatos editoriales tras el cuerpo de la fábula. */
	.cierre {
		margin-top: var(--space-2xl);
		padding-top: var(--space-md);
		border-top: var(--rule-hairline) solid var(--color-oro);
		text-align: center;
	}
	.curaduria {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	.curaduria strong {
		font-style: normal;
		color: var(--color-text);
	}
	.meta-fechas {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-xs);
		color: var(--color-text-soft);
		margin: var(--space-2xs) 0 0;
	}
	.meta-fechas-actualizada {
		font-style: italic;
	}
/* Nota editorial del curador, opcional, después del cuerpo */
	.nota-curador {
		margin-top: var(--space-2xl);
		padding-block: var(--space-lg);
		border-top: var(--rule-hairline) solid var(--color-oro);
		border-bottom: var(--rule-hairline) solid var(--color-oro);
	}
	.nota-curador-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-2xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		text-align: center;
		margin: 0 0 var(--space-md);
	}
	.nota-curador-cuerpo :global(p) {
		font-size: var(--fs-sm);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-sm);
	}
	.nota-curador-cuerpo :global(p:last-child) {
		margin-bottom: 0;
	}
	.nota-curador-cuerpo :global(em) {
		font-style: italic;
	}
	.nota-curador-cuerpo :global(strong) {
		font-weight: var(--fw-bold);
	}
	/* ── Taxonomía: cuatro grupos al pie de la fábula ────────────────────── */
	.taxonomia {
		margin-top: var(--space-xl);
		padding-top: var(--space-md);
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}
	.taxonomia-grupo {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-xs) var(--space-md);
	}
	.taxonomia-rotulo {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-oro-texto);
		font-weight: var(--fw-bold);
		text-transform: uppercase;
		flex-shrink: 0;
		min-width: 6.5rem;
	}
	.taxonomia-lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-sm);
	}
	.taxonomia-lista a {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		color: var(--color-esmeralda);
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid transparent;
		transition: border-color var(--dur-fast) var(--ease-standard);
	}
	.taxonomia-lista a:hover,
	.taxonomia-lista a:focus-visible {
		border-bottom-color: var(--color-esmeralda);
	}
</style>