---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Sobre · ${SITE_TITLE}`} description="Sobre El Fabulario." />
	</head>
	<body>
		<Header />
		<main class="page sobre">
			<header class="title">
				<Sol width="80px" />
				<h1>Sobre El Fabulario</h1>
			</header>

			<hr class="ornate" />

			<section class="prose">
				<p>
					El Fabulario es una colección abierta de fábulas en español. Reúne historias breves
					con moraleja —antiguas y nuevas— escritas por autores invitados.
				</p>
				<p>
					Cada fábula se publica con la firma que elige su autor: nombre real o seudónimo.
					Las ilustraciones siguen una línea estética Art-Déco coherente con el resto del
					proyecto.
				</p>

				<h2>Colaboraciones</h2>
				<p>
					Si te interesa aportar una fábula, escribe a
					<a href="mailto:moralesloaiza@gmail.com">moralesloaiza@gmail.com</a>. Los
					colaboradores reciben acceso al panel de edición para publicar directamente.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sobre {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0;
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.prose {
		max-width: var(--measure);
		margin-inline: auto;
	}
	.prose p {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
	}
	.prose h2 {
		font-size: var(--fs-xl);
		margin-top: var(--space-2xl);
		margin-bottom: var(--space-md);
		text-align: center;
	}
</style>
