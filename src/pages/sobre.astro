---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const pagina = await getEntry('paginas', 'sobre');
if (!pagina) throw new Error('[paginas] Falta src/content/paginas/sobre.md');
const { Content } = await render(pagina);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Acerca de · ${SITE_TITLE}`} description="El Fabulario reúne fábulas clásicas y contemporáneas en español, desde Esopo, La Fontaine, Iriarte y Samaniego hasta autores actuales, en texto y audio." />
	</head>
	<body>
		<Header />
		<main class="page sobre">
			<header class="title">
				<h1>{pagina.data.titulo}</h1>
				{pagina.data.subtitulo && <p class="subtitulo">{pagina.data.subtitulo}</p>}
			</header>

			<hr class="ornate" />

			<section class="prose">
				<Content />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sobre {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0;
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.prose {
		max-width: var(--measure);
		margin-inline: auto;
	}
	.prose p {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
	}
</style>
