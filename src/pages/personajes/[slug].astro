---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ListadoFabulasTaxonomia from '../../components/ListadoFabulasTaxonomia.astro';
import { PERSONAJES_DISPLAY, type Personaje } from '../../utils/taxonomia';

export async function getStaticPaths() {
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
	const autores = await getCollection('autores');
	const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

	const porSlug = new Map<string, typeof fabulas>();
	for (const f of fabulas) {
		for (const p of f.data.personajes) {
			if (!porSlug.has(p)) porSlug.set(p, []);
			porSlug.get(p)!.push(f);
		}
	}

	return Array.from(porSlug.entries()).map(([slug, fs]) => ({
		params: { slug },
		props: {
			slug: slug as Personaje,
			fabulas: fs.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
			autorMap,
		},
	}));
}

const { slug, fabulas, autorMap } = Astro.props;
const display = PERSONAJES_DISPLAY[slug];
const contadorTexto =
	fabulas.length === 1
		? '1 fábula con este personaje'
		: `${fabulas.length} fábulas con este personaje`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Personaje: ${display} · El Fabulario`}
			description={`Fábulas con ${display} en El Fabulario.`}
		/>
	</head>
	<body>
		<Header />
		<ListadoFabulasTaxonomia
			rotulo="Personaje"
			display={display}
			fabulas={fabulas}
			autorMap={autorMap}
			contadorTexto={contadorTexto}
			vacioTexto="Aún no hay fábulas publicadas con este personaje."
		/>
		<Footer />
	</body>
</html>