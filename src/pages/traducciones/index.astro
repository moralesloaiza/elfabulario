---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FabulaCard from '../../components/FabulaCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const fabulas = (
	await getCollection('fabulas', ({ data }) => !data.borrador && data.traduccion)
).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const total = fabulas.length;

// id→nombre del autor original (el campo `autor` es una referencia).
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

const TITULO = 'Traducciones';
const SUBTITULO =
	'Fábulas de autores de otras lenguas, traducidas al español para El Fabulario.';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${TITULO} · ${SITE_TITLE}`} description={SUBTITULO} />
	</head>
	<body>
		<Header />
		<main class="page indice-traducciones">
			<header class="cabecera">
				<p class="eyebrow">Explorar</p>
				<h1>{TITULO}</h1>
				<p class="intro">{SUBTITULO}</p>
			</header>

			<section class="listado" aria-labelledby="lista-titulo">
				<p class="conteo" id="lista-titulo">
					{total === 0
						? 'Aún no hay traducciones publicadas.'
						: total === 1
							? '1 fábula traducida al español.'
							: `${total} fábulas traducidas al español.`}
				</p>

				{total > 0 && (
					<ul class="rejilla">
						{fabulas.map((fabula) => (
							<li class="rejilla-item">
								<FabulaCard
									fabula={fabula}
									autorNombre={autoresPorId.get(fabula.data.autor.id) ?? ''}
								/>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.indice-traducciones {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6.25rem);
	}

	/* ── Cabecera (handoff §2, patrón Fase 2): eyebrow → H1 → intro ────────── */
	.cabecera {
		margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}
	.cabecera h1 {
		margin: var(--space-md) 0 0;
		font-size: var(--fs-3xl);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		text-wrap: balance;
	}
	.intro {
		margin: var(--space-md) 0 0;
		max-width: 41rem;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
	}

	/* ── Conteo sobre filete oro (eco de la barra de Fase 2) ──────────────── */
	.listado {
		border-top: var(--rule-thin) solid var(--color-oro);
		padding-top: var(--space-lg);
	}
	.conteo {
		margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
	}

	/* ── Rejilla de fichas (patrón Fase 2, filas 3:2 de FabulaCard) ───────── */
	.rejilla {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: clamp(24px, 3vw, 40px);
	}
	.rejilla-item {
		display: flex;
	}
</style>
