---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Correspondencia · ${SITE_TITLE}`}
			description="Cartas del público al curador de El Fabulario. Las seleccionadas se publican en la bitácora con réplica del curador."
		/>
	</head>
	<body>
		<Header />
		<main class="page correspondencia">
			<header class="title">
				<Sol width="80px" />
				<h1>Correspondencia</h1>
			</header>

			<hr class="ornate" />

			<section class="prose">
				<p>
					<em>El Fabulario</em> recibe cartas de lectores: comentarios sobre
					una fábula, interpretaciones, preguntas al curador, hallazgos sobre
					autores. Las cartas seleccionadas se publican en la
					<a href="/entradas/cartas/">sección de cartas de la bitácora</a> con
					la réplica del curador.
				</p>
				<p>
					Para escribir, completa el formulario y pulsa <em>Preparar carta</em>.
					Te mostraremos el mensaje listo para enviar; podrás abrirlo en tu
					cliente de correo o copiarlo y enviarlo a mano a
					<a href="mailto:contacto@elfabulario.com">contacto@elfabulario.com</a>.
				</p>
			</section>

			<form id="carta-form" class="carta-form" novalidate>
				<fieldset class="campo">
					<legend>¿Cómo firmas?</legend>
					<label class="radio">
						<input type="radio" name="modo" value="real" checked />
						<span>Con mi nombre real</span>
					</label>
					<label class="radio">
						<input type="radio" name="modo" value="seudonimo" />
						<span>Con un seudónimo</span>
					</label>
					<label class="radio">
						<input type="radio" name="modo" value="anonimo" />
						<span>Anónimo (firmaré como «Un lector»)</span>
					</label>
				</fieldset>

				<div class="campo">
					<label for="firma">Firma</label>
					<input
						type="text"
						id="firma"
						name="firma"
						required
						maxlength="120"
						autocomplete="name"
						placeholder="Tu nombre o seudónimo"
					/>
				</div>

				<div class="campo">
					<label for="fabula">Fábula referida <span class="opcional">(opcional)</span></label>
					<input
						type="text"
						id="fabula"
						name="fabula"
						maxlength="200"
						placeholder="Título o enlace de elfabulario.com"
						aria-describedby="fabula-ayuda fabula-error"
					/>
					<small id="fabula-ayuda" class="ayuda">
						Si la carta discute una fábula concreta, escribe su título o pega
						el enlace (solo se aceptan enlaces de <em>elfabulario.com</em>).
						Si no, deja el campo vacío.
					</small>
					<p id="fabula-error" class="error" role="alert" hidden></p>
				</div>

				<div class="campo">
					<label for="asunto">Asunto</label>
					<input
						type="text"
						id="asunto"
						name="asunto"
						required
						maxlength="160"
						placeholder="De qué trata tu carta"
					/>
				</div>

				<div class="campo">
					<label for="mensaje">Mensaje</label>
					<textarea
						id="mensaje"
						name="mensaje"
						rows="10"
						required
						placeholder="Escribe aquí tu carta. Toma el tiempo que necesites."
					></textarea>
				</div>

				<div class="campo consent">
					<label class="checkbox">
						<input type="checkbox" id="consent" name="consent" required />
						<span>
							Autorizo a <em>El Fabulario</em> a publicar selectivamente esta
							carta junto a la réplica del curador, con la firma indicada.
						</span>
					</label>
				</div>

				<div class="actions">
					<button type="submit" class="enviar">Preparar carta</button>
				</div>
			</form>

			<section id="preview" class="preview" hidden aria-live="polite">
				<hr class="ornate" />
				<h2>Tu carta está lista</h2>
				<p class="preview-intro">
					Pulsa <em>Abrir cliente de correo</em> para enviarla desde tu app
					predeterminada. Si no se abre, pulsa <em>Copiar al portapapeles</em>
					y pega el mensaje en un correo manual a
					<a href="mailto:contacto@elfabulario.com">contacto@elfabulario.com</a>.
				</p>

				<dl class="preview-meta">
					<dt>Destinatario</dt>
					<dd>contacto@elfabulario.com</dd>
					<dt>Asunto</dt>
					<dd id="preview-asunto"></dd>
				</dl>

				<pre id="preview-cuerpo" class="preview-cuerpo"></pre>

				<div class="preview-actions">
					<a id="preview-mailto" class="enviar" href="#">Abrir cliente de correo</a>
					<button type="button" id="preview-copiar" class="enviar secundario">
						Copiar al portapapeles
					</button>
				</div>
				<p id="preview-feedback" class="preview-feedback" role="status"></p>
			</section>

			<noscript>
				<p class="noscript-aviso">
					Este formulario necesita JavaScript para preparar el correo. Si lo
					tienes desactivado, escribe directamente a
					<a href="mailto:contacto@elfabulario.com">contacto@elfabulario.com</a>.
				</p>
			</noscript>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const form = document.getElementById('carta-form');
				if (!form) return;

				const firma = document.getElementById('firma');
				const radios = document.querySelectorAll('input[name="modo"]');
				const fabulaInput = document.getElementById('fabula');
				const fabulaError = document.getElementById('fabula-error');
				const preview = document.getElementById('preview');
				const previewAsunto = document.getElementById('preview-asunto');
				const previewCuerpo = document.getElementById('preview-cuerpo');
				const previewMailto = document.getElementById('preview-mailto');
				const previewCopiar = document.getElementById('preview-copiar');
				const previewFeedback = document.getElementById('preview-feedback');

				const HOSTS_PERMITIDOS = ['elfabulario.com', 'www.elfabulario.com'];

				// Modo anonimo: firma forzada a "Un lector" y campo bloqueado.
				function aplicarModo() {
					const modo = document.querySelector('input[name="modo"]:checked').value;
					if (modo === 'anonimo') {
						firma.value = 'Un lector';
						firma.setAttribute('readonly', '');
					} else {
						firma.removeAttribute('readonly');
						if (firma.value === 'Un lector') firma.value = '';
					}
				}
				radios.forEach((r) => r.addEventListener('change', aplicarModo));
				aplicarModo();

				// Mostrar/ocultar mensaje de error del campo "fabula referida".
				function mostrarErrorFabula(msg) {
					fabulaError.textContent = msg;
					fabulaError.hidden = false;
					fabulaInput.setAttribute('aria-invalid', 'true');
				}
				function limpiarErrorFabula() {
					fabulaError.textContent = '';
					fabulaError.hidden = true;
					fabulaInput.removeAttribute('aria-invalid');
				}
				fabulaInput.addEventListener('input', limpiarErrorFabula);

				// Valida el campo "fabula": si parece URL, debe ser de elfabulario.com.
				// Texto libre (sin "://") pasa sin restriccion.
				function validarFabula(valor) {
					if (!valor) return { ok: true };
					if (!valor.includes('://')) return { ok: true };
					let url;
					try {
						url = new URL(valor);
					} catch (err) {
						return {
							ok: false,
							msg: 'El enlace no es una URL válida. Escribe solo el título, o pega una URL completa de elfabulario.com.',
						};
					}
					if (url.protocol !== 'http:' && url.protocol !== 'https:') {
						return {
							ok: false,
							msg: 'Solo se aceptan enlaces http o https.',
						};
					}
					if (!HOSTS_PERMITIDOS.includes(url.hostname)) {
						return {
							ok: false,
							msg: 'Solo se aceptan enlaces de elfabulario.com. Si la fábula está en otro sitio, escribe su título en su lugar.',
						};
					}
					return { ok: true };
				}

				form.addEventListener('submit', function (e) {
					e.preventDefault();

					if (!form.checkValidity()) {
						form.reportValidity();
						return;
					}

					const fabula = fabulaInput.value.trim();
					const validacion = validarFabula(fabula);
					if (!validacion.ok) {
						mostrarErrorFabula(validacion.msg);
						fabulaInput.focus();
						return;
					}
					limpiarErrorFabula();

					const modo = document.querySelector('input[name="modo"]:checked').value;
					const modoEtiqueta = {
						real: 'nombre real',
						seudonimo: 'seudónimo',
						anonimo: 'anónimo',
					}[modo];

					const valorFirma = firma.value.trim() || 'Un lector';
					const asunto = document.getElementById('asunto').value.trim();
					const mensaje = document.getElementById('mensaje').value.trim();

					let cuerpo = '';
					cuerpo += 'Firma: ' + valorFirma + ' (' + modoEtiqueta + ')\n';
					if (fabula) cuerpo += 'Fábula referida: ' + fabula + '\n';
					cuerpo += '\n' + mensaje + '\n\n';
					cuerpo += '---\n';
					cuerpo += 'Autorizo la publicación selectiva de esta carta en El Fabulario.';

					const subject = '[El Fabulario · Carta] ' + asunto;
					const mailto =
						'mailto:contacto@elfabulario.com' +
						'?subject=' + encodeURIComponent(subject) +
						'&body=' + encodeURIComponent(cuerpo);

					// Poblar la vista previa.
					previewAsunto.textContent = subject;
					previewCuerpo.textContent = cuerpo;
					previewMailto.setAttribute('href', mailto);
					previewFeedback.textContent = '';

					preview.hidden = false;
					preview.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});

				previewCopiar.addEventListener('click', async function () {
					const texto =
						'Para: contacto@elfabulario.com\n' +
						'Asunto: ' + previewAsunto.textContent + '\n\n' +
						previewCuerpo.textContent;
					try {
						await navigator.clipboard.writeText(texto);
						previewFeedback.textContent = 'Mensaje copiado. Pégalo en un correo nuevo.';
					} catch (err) {
						// Fallback: seleccionar el bloque para copia manual.
						const range = document.createRange();
						range.selectNodeContents(previewCuerpo);
						const sel = window.getSelection();
						sel.removeAllRanges();
						sel.addRange(range);
						previewFeedback.textContent =
							'No pude copiar automáticamente. El mensaje quedó seleccionado: pulsa Ctrl+C (o Cmd+C).';
					}
				});
			})();
		</script>
	</body>
</html>

<style>
	.correspondencia {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0;
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.prose {
		max-width: var(--measure);
		margin-inline: auto;
		margin-bottom: var(--space-2xl);
	}
	.prose p {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
	}

	/* --- Formulario --- */
	.carta-form {
		max-width: var(--measure);
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}
	.campo {
		display: flex;
		flex-direction: column;
		gap: 0.35em;
	}
	.campo > label,
	.campo > legend {
		font-family: 'Cinzel', serif;
		font-size: var(--fs-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text);
	}
	.campo .opcional {
		text-transform: none;
		letter-spacing: normal;
		font-family: inherit;
		font-size: 0.85em;
		color: var(--text-soft);
		font-style: italic;
	}
	.campo .ayuda {
		font-family: 'Cormorant Garamond', serif;
		font-size: 0.95em;
		font-style: italic;
		color: var(--text-soft);
		line-height: var(--lh-relaxed);
		margin-top: 0.2em;
	}
	.campo .error {
		font-family: 'Cormorant Garamond', serif;
		font-size: 0.95em;
		color: var(--accent);
		line-height: var(--lh-relaxed);
		margin: 0.3em 0 0;
		padding: 0.5em 0.75em;
		border-left: 3px solid var(--accent);
		background: rgba(212, 91, 60, 0.08);
	}

	/* Inputs: afordancia clara, tactil, sin zoom en iOS.
	   Fondo blanco roto + borde oro 1.5px + sombra inset marcada
	   para que el ojo lea "hundido, editable". */
	.campo input[type='text'],
	.campo textarea {
		font-family: 'Cormorant Garamond', serif;
		font-size: 1.05rem; /* >= 16px evita zoom de iOS */
		padding: 0.75em 0.9em;
		min-height: 48px;
		background: #FBF8EC;
		color: var(--text);
		border: 1.5px solid var(--rule);
		border-radius: 2px;
		box-shadow: inset 0 2px 4px rgba(26, 23, 20, 0.08);
		outline-offset: 2px;
		transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.campo input[type='text']::placeholder,
	.campo textarea::placeholder {
		color: var(--text-soft);
		opacity: 0.55;
		font-style: normal;
	}
	.campo input[type='text']:hover,
	.campo textarea:hover {
		background: #FFFDF5;
		border-color: var(--accent);
	}
	.campo input[type='text']:focus,
	.campo textarea:focus {
		background: #FFFFFF;
		border-color: var(--accent);
		box-shadow: inset 0 2px 4px rgba(26, 23, 20, 0.08),
			0 0 0 3px rgba(212, 91, 60, 0.18);
		outline: none;
	}
	.campo input[aria-invalid='true'] {
		border-color: var(--accent);
		background: rgba(212, 91, 60, 0.05);
	}
	.campo input[readonly] {
		opacity: 0.7;
		cursor: not-allowed;
		background: rgba(26, 23, 20, 0.04);
		box-shadow: none;
	}
	.campo textarea {
		resize: vertical;
		min-height: 12em;
		line-height: var(--lh-relaxed);
	}

	/* Fieldset (radios) */
	fieldset.campo {
		border: 1px solid var(--rule);
		padding: var(--space-md);
		border-radius: 2px;
	}
	fieldset.campo legend {
		padding: 0 0.5em;
	}
	.radio,
	.checkbox {
		display: flex;
		gap: 0.7em;
		align-items: flex-start;
		font-family: 'Cormorant Garamond', serif;
		font-size: 1.05rem;
		text-transform: none;
		letter-spacing: normal;
		line-height: var(--lh-relaxed);
		cursor: pointer;
		padding: 0.4em 0;
		min-height: 44px;
	}
	.radio input,
	.checkbox input {
		margin-top: 0.35em;
		flex-shrink: 0;
		width: 1.1em;
		height: 1.1em;
		cursor: pointer;
	}

	.consent {
		padding: var(--space-md);
		border: 1px dashed var(--rule);
		border-radius: 2px;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		align-items: center;
		margin-top: var(--space-md);
	}

	.enviar {
		font-family: 'Cinzel', serif;
		font-size: var(--fs-md);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.85em 2em;
		min-height: 44px;
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
		border-radius: 2px;
		cursor: pointer;
		text-decoration: none;
		display: inline-block;
		text-align: center;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.enviar:hover,
	.enviar:focus {
		background: var(--bg);
		color: var(--text);
	}
	.enviar.secundario {
		background: transparent;
		color: var(--text);
	}
	.enviar.secundario:hover,
	.enviar.secundario:focus {
		background: var(--text);
		color: var(--bg);
	}

	/* --- Vista previa --- */
	.preview {
		max-width: var(--measure);
		margin-inline: auto;
		margin-top: var(--space-2xl);
	}
	.preview h2 {
		font-family: 'Cinzel', serif;
		font-size: var(--fs-xl);
		text-align: center;
		margin: var(--space-lg) 0 var(--space-md);
	}
	.preview-intro {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
	}
	.preview-meta {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.4em 1em;
		margin-bottom: var(--space-md);
		font-size: var(--fs-md);
	}
	.preview-meta dt {
		font-family: 'Cinzel', serif;
		font-size: var(--fs-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-soft);
	}
	.preview-meta dd {
		margin: 0;
		font-family: 'Cormorant Garamond', serif;
	}
	.preview-cuerpo {
		background: #FBF8EC;
		border: 1px solid var(--rule);
		border-radius: 2px;
		padding: var(--space-md);
		font-family: 'Cormorant Garamond', serif;
		font-size: 1.05rem;
		line-height: var(--lh-relaxed);
		white-space: pre-wrap;
		word-wrap: break-word;
		max-height: 24em;
		overflow-y: auto;
	}
	.preview-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		justify-content: center;
		margin-top: var(--space-md);
	}
	.preview-feedback {
		text-align: center;
		font-size: var(--fs-sm);
		color: var(--text-soft);
		min-height: 1.5em;
		margin-top: var(--space-sm);
	}

	.noscript-aviso {
		max-width: var(--measure);
		margin-inline: auto;
		margin-top: var(--space-lg);
		padding: var(--space-md);
		border: 1px solid var(--accent);
		font-size: var(--fs-md);
	}

	@media (max-width: 640px) {
		.preview-actions {
			flex-direction: column;
		}
		.preview-actions .enviar {
			width: 100%;
		}
	}
</style>