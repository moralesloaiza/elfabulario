---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FabulaCard from '../components/FabulaCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import JsonLd from '../components/JsonLd.astro';
import { buildWebSiteJsonLd } from '../utils/jsonld';

const ultimas = (await getCollection('fabulas', ({ data }) => !data.borrador))
	.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
	.slice(0, 6);

// Author names live in the `autores` collection now (the `autor` field on a
// fable is a reference, not a string). Build an id→name map once so the
// template can render the author without awaiting per row.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd data={buildWebSiteJsonLd()} />
	</head>
	<body>
		<Header />
		<main class="page home">
			<section class="hero">
				<Sol />
				<h1>{SITE_TITLE}</h1>
				<p class="subtitulo">{SITE_TAGLINE}</p>
				<hr class="ornate hero-rule" />
			</section>

			{ultimas.length > 0 && (
				<section class="seccion-fabulas" aria-labelledby="ultimas-titulo">
					<h2 id="ultimas-titulo" class="seccion-titulo">Últimas fábulas</h2>
					<ul class="fabulas">
						{ultimas.map((fabula) => (
							<li>
								<FabulaCard
									fabula={fabula}
									autorNombre={autoresPorId.get(fabula.data.autor.id) ?? ''}
								/>
							</li>
						))}
					</ul>
				</section>
			)}

			<section class="seccion-explorar" aria-labelledby="explorar-titulo">
				<p class="eyebrow">— Explorar —</p>
				<h2 id="explorar-titulo" class="seccion-titulo">Sigue leyendo</h2>
				<ul class="exploracion">
					<li>
						<a href="/fabulas/">
							<span class="numeral" aria-hidden="true">I</span>
							<h3 class="titulo-explorar">Catálogo</h3>
							<p class="descripcion-explorar">Todas las fábulas.</p>
						</a>
					</li>
					<li>
						<a href="/autores/">
							<span class="numeral" aria-hidden="true">II</span>
							<h3 class="titulo-explorar">Autores</h3>
							<p class="descripcion-explorar">Clásicos y colaboradores.</p>
						</a>
					</li>
					<li>
						<button type="button" class="explorar-trigger" data-buscador-trigger>
							<span class="numeral" aria-hidden="true">III</span>
							<h3 class="titulo-explorar">Búsqueda</h3>
							<p class="descripcion-explorar">Por título o autor.</p>
						</button>
					</li>
					<li>
						<a href="/colaborar/">
							<span class="numeral" aria-hidden="true">IV</span>
							<h3 class="titulo-explorar">Colaborar</h3>
							<p class="descripcion-explorar">¿Escribes fábulas?</p>
						</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-block: var(--space-2xl) var(--space-lg);
	}

	/* ---------- HERO ---------- */
	.hero {
		text-align: center;
		margin-bottom: var(--space-4xl);
	}
	.hero h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-4xl);
		text-wrap: balance;
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-xl);
	}
	.hero-rule {
		max-width: 240px;
	}

	/* ---------- ÍNDICE ---------- */
	.seccion-fabulas {
		margin-bottom: var(--space-4xl);
	}
	.seccion-titulo {
		text-align: center;
		font-size: var(--fs-xl);
		margin: 0 0 var(--space-xl);
	}
	ul.fabulas {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		max-width: none;
	}

	/* ---------- EXPLORAR ---------- */
	.seccion-explorar {
		text-align: center;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		max-width: none;
		margin: 0 0 var(--space-2xs);
	}
	.seccion-explorar .seccion-titulo {
		margin: 0 0 var(--space-xl);
	}
	ul.exploracion {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: var(--space-xl);
		row-gap: var(--space-lg);
	}
	ul.exploracion a,
	ul.exploracion .explorar-trigger {
		display: block;
		width: 100%;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md) 0;
		background: transparent;
		border: 0;
		font: inherit;
		text-align: inherit;
		cursor: pointer;
	}
	.numeral {
		display: block;
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		color: var(--color-oro-texto);
		margin: 0 0 var(--space-2xs);
	}
	.titulo-explorar {
		font-family: var(--font-display);
		font-size: var(--fs-sm);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: uppercase;
	}
	ul.exploracion a:hover .titulo-explorar,
	ul.exploracion a:focus-visible .titulo-explorar,
	ul.exploracion .explorar-trigger:hover .titulo-explorar,
	ul.exploracion .explorar-trigger:focus-visible .titulo-explorar {
		color: var(--color-oro-texto);
	}
	.descripcion-explorar {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 900px) {
		ul.exploracion {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-2xl);
		}
	}
	@media (max-width: 720px) {
		ul.fabulas {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
		ul.exploracion {
			grid-template-columns: 1fr;
			row-gap: var(--space-xl);
		}
	}
</style>