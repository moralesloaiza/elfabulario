---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import EscuchaEnSpotify from '../components/EscuchaEnSpotify.astro';
import FichaFabula from '../components/FichaFabula.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroInmersivo from '../components/HeroInmersivo.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { buildWebSiteJsonLd } from '../utils/jsonld';
import { tiempoLecturaMin } from '../utils/lectura';
import { numeroEnLetrasFemCap } from '../utils/numeroEnLetras';
import { FORMAS_DISPLAY, TRADICIONES_DISPLAY } from '../utils/taxonomia';

const home = await getEntry('paginas', 'home');
if (!home) throw new Error('[paginas] Falta src/content/paginas/home.md');

// Nombres de autor: el campo `autor` de una fábula es una referencia, no un
// string. Mapa id→nombre para no await por fila.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// Todas las fábulas publicadas, recientes primero. Sirve para el recuento del
// archivo y para la rejilla de últimas.
const fabulasPublicadas = (await getCollection('fabulas', ({ data }) => !data.borrador))
	.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const totalFabulas = fabulasPublicadas.length;

// --- Cargar el destacado (singleton curatorial) ---
// La colección `destacado` es polimórfica: fábula, entrada o autor. Se resuelve
// la referencia aquí y se valida que el target tenga imagen (Zod no hace
// cross-collection lookups). El eyebrow del hero lleva metadatos de lectura.
const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
	eyebrow: string;
	imagen: import('astro').ImageMetadata;
	alt: string;
	titulo: string;
	href: string;
	foco?: number;
	esRetrato?: boolean;
	byline?: string;
	lede?: string;
};

let destacado: DestacadoRender | null = null;
let destacadaFabulaId: string | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
	const { tipo, cintillo } = destacadoCfg.data;

	if (tipo === 'fabula' && destacadoCfg.data.fabula_referida) {
		const fabula = await getEntry(destacadoCfg.data.fabula_referida);
		if (!fabula.data.ilustracion) {
			throw new Error(
				`[destacado] La fábula "${fabula.data.titulo}" no tiene ilustración. ` +
					`El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
			);
		}
		destacadaFabulaId = fabula.id;
		const autor = await getEntry(fabula.data.autor);
		const min = tiempoLecturaMin(fabula.body);
		const eyebrow = [
			cintillo,
			fabula.data.tradicion ? TRADICIONES_DISPLAY[fabula.data.tradicion] : null,
			FORMAS_DISPLAY[fabula.data.forma],
			`${min} min`,
		].filter(Boolean).join(' · ');
		destacado = {
			eyebrow,
			imagen: fabula.data.ilustracion,
			alt: '',
			titulo: fabula.data.titulo,
			href: `/fabulas/${fabula.id}/`,
			foco: fabula.data.foco,
			byline: autor.data.nombre,
			lede: fabula.data.resumen,
		};
	} else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
		const entrada = await getEntry(destacadoCfg.data.entrada_referida);
		if (!entrada.data.ilustracion) {
			throw new Error(
				`[destacado] La entrada "${entrada.data.titulo}" no tiene ilustración. ` +
					`El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
			);
		}
		destacado = {
			eyebrow: cintillo,
			imagen: entrada.data.ilustracion,
			alt: '',
			titulo: entrada.data.titulo,
			href: `/entradas/${entrada.id}/`,
			foco: entrada.data.foco,
			lede: entrada.data.resumen,
		};
	} else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
		const autor = await getEntry(destacadoCfg.data.autor_referido);
		if (!autor.data.imagen) {
			throw new Error(
				`[destacado] El autor "${autor.data.nombre}" no tiene retrato. ` +
					`El destacado activo requiere imagen. Añade un retrato o cambia el destacado.`,
			);
		}
		destacado = {
			eyebrow: cintillo,
			imagen: autor.data.imagen,
			alt: `Retrato de ${autor.data.nombre}`,
			titulo: autor.data.nombre,
			href: `/autores/${autor.id}/`,
			foco: autor.data.foco,
			esRetrato: true,
			lede: [autor.data.nacionalidad, autor.data.siglo].filter(Boolean).join(' · ') || undefined,
		};
	}
}

// Cartelera: cinco fichas ilustradas (excluyendo la destacada, para no
// duplicarla) + una cartela de acceso al archivo como sexta celda.
const ultimas = fabulasPublicadas
	.filter((f) => f.data.ilustracion && f.id !== destacadaFabulaId)
	.slice(0, 5)
	.map((fabula) => ({ fabula, minutos: tiempoLecturaMin(fabula.body) }));

// Ejes de exploración (dirección Cartelera).
const ejes = [
	{ num: 'I', titulo: 'Por tradición', glosa: 'Clásica, hispánica, oriental.', href: '/tradiciones/' },
	{ num: 'II', titulo: 'Por autor', glosa: 'Clásicos y colaboradores.', href: '/autores/' },
	{ num: 'III', titulo: 'Por forma', glosa: 'Verso o prosa.', href: '/formas/' },
	{ num: 'IV', titulo: 'Por moraleja', glosa: 'Índice temático.', href: '/temas/' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd data={buildWebSiteJsonLd()} />
	</head>
	<body>
		<Header />
		<main class="home">
			{destacado ? (
				<HeroInmersivo
					imagen={destacado.imagen}
					alt={destacado.alt}
					foco={destacado.foco}
					esRetrato={destacado.esRetrato}
					altura="450px"
					eyebrow={destacado.eyebrow}
					titulo={destacado.titulo}
					href={destacado.href}
					byline={destacado.byline}
					lede={destacado.lede}
				/>
			) : (
				<section class="hero-texto">
					<h1>{SITE_TITLE}</h1>
					<p class="subtitulo">{home.data.subtitulo}</p>
				</section>
			)}

			<EscuchaEnSpotify />

			{ultimas.length > 0 && (
				<section class="page seccion-fabulas" aria-labelledby="ultimas-titulo">
					<div class="seccion-encabezado">
						<h2 id="ultimas-titulo" class="seccion-titulo">Últimas fábulas</h2>
						<a class="ver-todas" href="/fabulas/">Ver todas</a>
					</div>
					<ul class="cartelera">
						{ultimas.map(({ fabula, minutos }) => (
							<li>
								<FichaFabula
									fabula={fabula}
									autorNombre={autoresPorId.get(fabula.data.autor.id) ?? ''}
									minutos={minutos}
								/>
							</li>
						))}
						<li>
							<a class="cartela" href="/fabulas/">
								<span class="cartela-eyebrow">Archivo completo</span>
								<span class="cartela-cifra">{numeroEnLetrasFemCap(totalFabulas)} fábulas</span>
								<span class="cartela-glosa">De Esopo a los fabulistas de hoy, reunidas y leídas con calma.</span>
								<span class="cartela-enlace">Entrar al índice →</span>
							</a>
						</li>
					</ul>
				</section>
			)}

			<section class="seccion-explorar" aria-labelledby="explorar-titulo">
				<div class="page explorar-inner">
					<h2 id="explorar-titulo" class="sr-only">Explorar el archivo</h2>
					<ul class="ejes">
						{ejes.map((eje) => (
							<li>
								<a class="eje" href={eje.href}>
									<span class="eje-num" aria-hidden="true">{eje.num}</span>
									<span class="eje-texto">
										<span class="eje-titulo">{eje.titulo}</span>
										<span class="eje-glosa">{eje.glosa}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-block: 0;
	}

	/* ---------- HERO de texto (fallback sin destacado) ---------- */
	.hero-texto {
		text-align: center;
		margin-block: var(--space-3xl) var(--space-2xl);
	}
	.hero-texto h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-4xl);
		text-wrap: balance;
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}

	/* ---------- ÚLTIMAS FÁBULAS · cartelera ---------- */
	.seccion-fabulas {
		padding-block: clamp(var(--space-xl), 3vw, var(--space-2xl));
	}
	.seccion-encabezado {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
		border-bottom: var(--rule-thin) solid var(--color-oro);
		padding-bottom: var(--space-sm);
		margin-bottom: var(--space-lg);
	}
	.seccion-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-medium);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		margin: 0;
	}
	.ver-todas {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		text-decoration: none;
		white-space: nowrap;
	}
	.ver-todas:hover,
	.ver-todas:focus-visible {
		color: var(--color-esmeralda);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
	ul.cartelera {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: clamp(var(--space-lg), 2.4vw, 1.875rem);
	}

	/* Cartela de archivo (6ª celda) · doble encuadre de cartela */
	.cartela {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-sm);
		height: 100%;
		padding: clamp(var(--space-lg), 2.4vw, 1.875rem);
		background: var(--color-marfil-alt);
		border: var(--rule-thin) solid var(--color-oro);
		outline: var(--rule-thin) solid rgba(201, 161, 74, 0.45);
		outline-offset: -9px;
		text-decoration: none;
		color: inherit;
	}
	.cartela-eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
	}
	.cartela-cifra {
		font-family: var(--font-display);
		font-size: var(--fs-xl);
		font-weight: var(--fw-regular);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		color: var(--color-text);
	}
	.cartela-glosa {
		font-family: var(--font-body);
		font-size: var(--fs-md);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
	}
	.cartela-enlace {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-zafiro);
		border-top: var(--rule-thin) solid var(--color-oro);
		padding-top: var(--space-sm);
		margin-top: var(--space-2xs);
	}
	.cartela:hover .cartela-enlace,
	.cartela:focus-visible .cartela-enlace {
		color: var(--color-esmeralda);
	}

	/* ---------- EXPLORAR ---------- */
	.seccion-explorar {
		background: var(--color-marfil-alt);
		border-top: var(--rule-medium) solid var(--color-oro);
	}
	.explorar-inner {
		padding-block: clamp(var(--space-lg), 2.4vw, var(--space-xl));
	}
	ul.ejes {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: clamp(var(--space-md), 2vw, 1.625rem);
	}
	.eje {
		display: flex;
		gap: var(--space-sm);
		align-items: baseline;
		text-decoration: none;
		color: inherit;
	}
	.eje-num {
		font-family: var(--font-display);
		font-size: 1.625rem; /* 26px · ≥24px permite oro decorativo */
		line-height: 1;
		color: var(--color-oro);
	}
	.eje-texto {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xs);
	}
	.eje-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-2xs);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		color: var(--color-text);
	}
	.eje:hover .eje-titulo,
	.eje:focus-visible .eje-titulo {
		color: var(--color-oro-texto);
	}
	.eje-glosa {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
	}
</style>
