---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Destacado from '../components/Destacado.astro';
import EscuchaEnSpotify from '../components/EscuchaEnSpotify.astro';
import FabulaCard from '../components/FabulaCard.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { buildWebSiteJsonLd } from '../utils/jsonld';

const home = await getEntry('paginas', 'home');
if (!home) throw new Error('[paginas] Falta src/content/paginas/home.md');

const ultimas = (await getCollection('fabulas', ({ data }) => !data.borrador))
	.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
	.slice(0, 6);

// Author names live in the `autores` collection now (the `autor` field on a
// fable is a reference, not a string). Build an id→name map once so the
// template can render the author without awaiting per row.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// --- Cargar el destacado (singleton curatorial) ---
// La colección `destacado` es polimórfica: el elemento referido puede ser una
// fábula, una entrada (bitácora o correspondencia) o un autor. Resolvemos la
// referencia aquí y validamos que el target tenga imagen — Zod no puede hacer
// cross-collection lookups, así que la validación vive en build-time aquí.

const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
	cintillo: string;
	imagen: import('astro').ImageMetadata;
	alt: string;
	titulo: string;
	href: string;
	autorNombre?: string;
	fecha?: Date;
	siglo?: string;
	nacionalidad?: string;
};

let destacado: DestacadoRender | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
	const { tipo, cintillo } = destacadoCfg.data;

	if (tipo === 'fabula' && destacadoCfg.data.fabula_referida) {
		const fabula = await getEntry(destacadoCfg.data.fabula_referida);
		if (!fabula.data.ilustracion) {
			throw new Error(
				`[destacado] La fábula "${fabula.data.titulo}" no tiene ilustración. ` +
					`El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
			);
		}
		const autor = await getEntry(fabula.data.autor);
		destacado = {
			cintillo,
			imagen: fabula.data.ilustracion,
			alt: '',
			titulo: fabula.data.titulo,
			href: `/fabulas/${fabula.id}/`,
			autorNombre: autor.data.nombre,
			fecha: fabula.data.fecha,
		};
	} else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
		const entrada = await getEntry(destacadoCfg.data.entrada_referida);
		if (!entrada.data.ilustracion) {
			throw new Error(
				`[destacado] La entrada "${entrada.data.titulo}" no tiene ilustración. ` +
					`El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
			);
		}
		destacado = {
			cintillo,
			imagen: entrada.data.ilustracion,
			alt: '',
			titulo: entrada.data.titulo,
			href: `/entradas/${entrada.id}/`,
			fecha: entrada.data.fecha,
		};
	} else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
		const autor = await getEntry(destacadoCfg.data.autor_referido);
		if (!autor.data.imagen) {
			throw new Error(
				`[destacado] El autor "${autor.data.nombre}" no tiene retrato. ` +
					`El destacado activo requiere imagen. Añade un retrato o cambia el destacado.`,
			);
		}
		destacado = {
			cintillo,
			imagen: autor.data.imagen,
			alt: `Retrato de ${autor.data.nombre}`,
			titulo: autor.data.nombre,
			href: `/autores/${autor.id}/`,
			siglo: autor.data.siglo,
			nacionalidad: autor.data.nacionalidad,
		};
	}
}
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd data={buildWebSiteJsonLd()} />
	</head>
	<body>
		<Header />
		<main class="page home">
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="subtitulo">{home.data.subtitulo}</p>
			</section>

			{destacado && (
				<Destacado
					cintillo={destacado.cintillo}
					imagen={destacado.imagen}
					alt={destacado.alt}
					titulo={destacado.titulo}
					href={destacado.href}
				>
					<Fragment slot="submeta">
						{destacado.autorNombre && destacado.fecha && (
							<p>por {destacado.autorNombre} · <FormattedDate date={destacado.fecha} /></p>
						)}
						{!destacado.autorNombre && destacado.fecha && (
							<p><FormattedDate date={destacado.fecha} /></p>
						)}
						{(destacado.nacionalidad || destacado.siglo) && (
							<p>
								{[destacado.nacionalidad, destacado.siglo].filter(Boolean).join(' · ')}
							</p>
						)}
					</Fragment>
				</Destacado>
			)}

			<EscuchaEnSpotify />

			{ultimas.length > 0 && (
				<section class="seccion-fabulas" aria-labelledby="ultimas-titulo">
					<h2 id="ultimas-titulo" class="seccion-titulo">Últimas fábulas</h2>
					<ul class="fabulas">
						{ultimas.map((fabula) => (
							<li>
								<FabulaCard
									fabula={fabula}
									autorNombre={autoresPorId.get(fabula.data.autor.id) ?? ''}
								/>
							</li>
						))}
					</ul>
				</section>
			)}

			<section class="seccion-explorar" aria-labelledby="explorar-titulo">
				<p class="eyebrow">— Explorar —</p>
				<h2 id="explorar-titulo" class="seccion-titulo">Sigue leyendo</h2>
				<ul class="exploracion">
					<li>
						<a href="/fabulas/">
							<span class="numeral" aria-hidden="true">I</span>
							<h3 class="titulo-explorar">Catálogo</h3>
							<p class="descripcion-explorar">Todas las fábulas.</p>
						</a>
					</li>
					<li>
						<a href="/autores/">
							<span class="numeral" aria-hidden="true">II</span>
							<h3 class="titulo-explorar">Autores</h3>
							<p class="descripcion-explorar">Clásicos y colaboradores.</p>
						</a>
					</li>
					<li>
						<button type="button" class="explorar-trigger" data-buscador-trigger>
							<span class="numeral" aria-hidden="true">III</span>
							<h3 class="titulo-explorar">Búsqueda</h3>
							<p class="descripcion-explorar">Por título o autor.</p>
						</button>
					</li>
					<li>
						<a href="/colaborar/">
							<span class="numeral" aria-hidden="true">IV</span>
							<h3 class="titulo-explorar">Colaborar</h3>
							<p class="descripcion-explorar">¿Escribes fábulas?</p>
						</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-block: var(--space-2xl) var(--space-lg);
	}

	/* ---------- HERO ---------- */
	.hero {
		text-align: center;
		margin-bottom: var(--space-2xl);
	}
	.hero h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-4xl);
		text-wrap: balance;
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}

	/* ---------- ÍNDICE ---------- */
	.seccion-fabulas {
		margin-bottom: var(--space-4xl);
	}
	.seccion-titulo {
		text-align: center;
		font-size: var(--fs-xl);
		margin: 0 0 var(--space-xl);
	}
	ul.fabulas {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		max-width: none;
	}

	/* ---------- EXPLORAR ---------- */
	.seccion-explorar {
		text-align: center;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		max-width: none;
		margin: 0 0 var(--space-2xs);
	}
	.seccion-explorar .seccion-titulo {
		margin: 0 0 var(--space-xl);
	}
	ul.exploracion {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: var(--space-xl);
		row-gap: var(--space-lg);
	}
	ul.exploracion a,
	ul.exploracion .explorar-trigger {
		display: block;
		width: 100%;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md) 0;
		background: transparent;
		border: 0;
		font: inherit;
		text-align: inherit;
		cursor: pointer;
	}
	.numeral {
		display: block;
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		color: var(--color-oro-texto);
		margin: 0 0 var(--space-2xs);
	}
	.titulo-explorar {
		font-family: var(--font-display);
		font-size: var(--fs-sm);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: uppercase;
	}
	ul.exploracion a:hover .titulo-explorar,
	ul.exploracion a:focus-visible .titulo-explorar,
	ul.exploracion .explorar-trigger:hover .titulo-explorar,
	ul.exploracion .explorar-trigger:focus-visible .titulo-explorar {
		color: var(--color-oro-texto);
	}
	.descripcion-explorar {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 900px) {
		ul.exploracion {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-2xl);
		}
	}
	@media (max-width: 720px) {
		ul.fabulas {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
		ul.exploracion {
			grid-template-columns: 1fr;
			row-gap: var(--space-xl);
		}
	}
</style>