---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sol from '../components/ornaments/Sol.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const ultimas = (await getCollection('fabulas', ({ data }) => !data.borrador))
	.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page home">
			<section class="hero">
				<Sol />
				<h1>{SITE_TITLE}</h1>
				<p class="subtitulo">{SITE_DESCRIPTION}</p>
				<hr class="ornate hero-rule" />
			</section>

			{ultimas.length > 0 && (
				<section class="seccion-fabulas" aria-labelledby="ultimas-titulo">
					<h2 id="ultimas-titulo" class="seccion-titulo">Últimas fábulas</h2>
					<ul class="fabulas">
						{ultimas.map((fabula) => (
							<li class="fabula-item">
								<a href={`/fabulas/${fabula.id}/`} class="fabula-link">
									{fabula.data.ilustracion && (
										<figure class="fabula-img">
											<Image
												width={600}
												height={400}
												src={fabula.data.ilustracion}
												alt=""
											/>
										</figure>
									)}
									<div class="fabula-meta">
										<h3 class="titulo-fabula">{fabula.data.titulo}</h3>
										<p class="autor-fabula">por {fabula.data.autor}</p>
										<p class="fecha-fabula">
											<FormattedDate date={fabula.data.fecha} />
										</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

<section class="seccion-explorar" aria-labelledby="explorar-titulo">
				<p class="eyebrow">— Explorar —</p>
				<h2 id="explorar-titulo" class="seccion-titulo">Sigue leyendo</h2>
				<ul class="exploracion">
					<li>
						<a href="/fabulas/">
							<h3 class="titulo-explorar">Todas las fábulas</h3>
							<p class="descripcion-explorar">El catálogo completo, ordenado cronológicamente.</p>
						</a>
					</li>
					<li>
						<a href="/autores/">
							<h3 class="titulo-explorar">Autores</h3>
							<p class="descripcion-explorar">Clásicos y colaboradores actuales.</p>
						</a>
					</li>
					<li>
						<button type="button" class="explorar-trigger" data-buscador-trigger>
							<h3 class="titulo-explorar">Buscar</h3>
							<p class="descripcion-explorar">Encuentra una fábula o un autor por nombre.</p>
						</button>
					</li>
					<li>
						<a href="mailto:contacto@elfabulario.com">
							<h3 class="titulo-explorar">Colaborar</h3>
							<p class="descripcion-explorar">¿Escribes fábulas o conoces alguna olvidada?</p>
						</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-block: var(--space-2xl);
	}

	/* ---------- HERO ---------- */
	.hero {
		text-align: center;
		margin-bottom: var(--space-4xl);
	}
	.hero h1 {
		margin: 0 0 var(--space-md);
		font-size: var(--fs-4xl);
		text-wrap: balance;
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-snug);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-xl);
	}
	.hero-rule {
		max-width: 240px;
	}

	/* ---------- ÍNDICE ---------- */
	.seccion-fabulas {
		margin-bottom: var(--space-4xl);
	}
	.seccion-titulo {
		text-align: center;
		font-size: var(--fs-xl);
		margin: 0 0 var(--space-xl);
	}
	ul.fabulas {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		max-width: none;
	}
.fabula-item {
		display: flex;
		flex-direction: column;
	}
	.fabula-link {
		display: flex;
		flex-direction: column;
		flex: 1;
		text-decoration: none;
		color: inherit;
	}
.fabula-img {
		margin: 0 0 var(--space-md);
		overflow: hidden;
		aspect-ratio: 3 / 2;
	}
	.fabula-img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.fabula-link:hover .fabula-img :global(img),
	.fabula-link:focus-visible .fabula-img :global(img) {
		transform: scale(1.02);
	}
	.titulo-fabula {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}
	.fabula-link:hover .titulo-fabula,
	.fabula-link:focus-visible .titulo-fabula {
		color: var(--color-oro-texto);
	}
	.autor-fabula {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	.fecha-fabula {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		/* uppercase eliminado: Cinzel ya es all-caps */
		color: var(--color-esmeralda);
		margin: var(--space-2xs) 0 0;
	}

/* ---------- EXPLORAR ---------- */
	.seccion-explorar {
		text-align: center;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		margin: 0 0 var(--space-2xs);
	}
	.seccion-explorar .seccion-titulo {
		margin: 0 0 var(--space-xl);
	}
	ul.exploracion {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
	}
	ul.exploracion a,
	ul.exploracion .explorar-trigger {
		display: block;
		width: 100%;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md) 0;
		background: transparent;
		border: 0;
		font: inherit;
		text-align: inherit;
		cursor: pointer;
	}
	.titulo-explorar {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}
	ul.exploracion a:hover .titulo-explorar,
	ul.exploracion a:focus-visible .titulo-explorar,
	ul.exploracion .explorar-trigger:hover .titulo-explorar,
	ul.exploracion .explorar-trigger:focus-visible .titulo-explorar {
		color: var(--color-oro-texto);
	}
	.descripcion-explorar {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	/* ---------- RESPONSIVE ---------- */
@media (max-width: 720px) {
		ul.fabulas,
		ul.exploracion {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
