---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sol from '../../components/ornaments/Sol.astro';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);

	// Agrupamos las fábulas por SLUG de etiqueta (no por la etiqueta original)
	// para que dos formas distintas de escribir la misma etiqueta —p.ej.
	// "Coraje" y "coraje"— se unifiquen en una sola página.
	// Para cada slug guardamos también la primera forma "humana" encontrada,
	// que se usará como título de la página.
	const grupos = new Map<string, { etiquetaHumana: string; fabulas: typeof fabulas }>();

	for (const f of fabulas) {
		const vistas = new Set<string>();
		for (const eOriginal of f.data.etiquetas) {
			const sl = slugify(eOriginal);
			if (!sl || vistas.has(sl)) continue;
			vistas.add(sl);
			if (!grupos.has(sl)) {
				grupos.set(sl, { etiquetaHumana: eOriginal, fabulas: [] });
			}
			grupos.get(sl)!.fabulas.push(f);
		}
	}

	return Array.from(grupos.entries()).map(([slug, { etiquetaHumana, fabulas }]) => ({
		params: { slug },
		props: {
			etiquetaHumana,
			fabulas: fabulas.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
		},
	}));
}

const { etiquetaHumana, fabulas } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`#${etiquetaHumana} · El Fabulario`}
			description={`Fábulas con la etiqueta ${etiquetaHumana} en El Fabulario.`}
		/>
	</head>
	<body>
		<Header />
		<main class="page indice">
			<header class="title">
				<Sol />
				<p class="kicker">Etiqueta</p>
				<h1>#{etiquetaHumana}</h1>
				<p class="subtitulo">
					{fabulas.length === 1
						? '1 fábula bajo esta etiqueta.'
						: `${fabulas.length} fábulas bajo esta etiqueta.`}
				</p>
			</header>

			<hr class="ornate" />

			<ul class="lista">
				{fabulas.map((fabula) => (
					<li class="item">
						<a href={`/fabulas/${fabula.id}/`} class="item-link">
							{fabula.data.ilustracion && (
								<figure class="item-img">
									<Image
										width={600}
										height={400}
										src={fabula.data.ilustracion}
										alt=""
									/>
								</figure>
							)}
							<div class="item-meta">
								<h2 class="item-titulo">{fabula.data.titulo}</h2>
								<p class="item-autor">por {fabula.data.autor}</p>
								<p class="item-fecha">
									<FormattedDate date={fabula.data.fecha} />
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.indice {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.kicker {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		margin: 0 0 var(--space-2xs);
	}
	.title h1 {
		margin: 0 0 var(--space-sm);
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}
	.lista {
		list-style: none;
		padding: 0;
		margin: var(--space-2xl) 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
	}
	.item-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.item-img {
		margin: 0 0 var(--space-md);
		overflow: hidden;
	}
	.item-img :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: var(--rule-hairline) solid var(--color-oro);
		transition: transform var(--dur-slow) var(--ease-standard);
	}
	.item-link:hover .item-img :global(img),
	.item-link:focus-visible .item-img :global(img) {
		transform: scale(1.02);
	}
	.item-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}
	.item-link:hover .item-titulo,
	.item-link:focus-visible .item-titulo {
		color: var(--color-oro-texto);
	}
	.item-autor {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin: 0;
	}
	.item-fecha {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-esmeralda);
		margin: var(--space-2xs) 0 0;
	}
	@media (max-width: 720px) {
		.lista {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
