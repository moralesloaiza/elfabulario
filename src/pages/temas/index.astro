---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { TEMAS_DISPLAY, type Tema } from '../../utils/taxonomia';
import { aRomano } from '../../utils/romano';

const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);

const conteo = new Map<Tema, number>();
for (const f of fabulas) {
	for (const t of f.data.temas) {
		conteo.set(t, (conteo.get(t) ?? 0) + 1);
	}
}

const items = Array.from(conteo.entries())
	.map(([slug, n]) => ({ slug, conteo: n, display: TEMAS_DISPLAY[slug] }))
	.sort((a, b) => {
		if (b.conteo !== a.conteo) return b.conteo - a.conteo;
		return a.display.localeCompare(b.display, 'es');
	});
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Temas · ${SITE_TITLE}`} description="Temas y moralejas de las fábulas del Fabulario." />
	</head>
	<body>
		<Header />
		<main class="page indice-taxonomia">
			<header class="cabecera">
				<p class="eyebrow">Explorar</p>
				<h1>Temas</h1>
				<p class="intro">Las moralejas y motivos que recorren las fábulas.</p>
			</header>

			<ol class="rejilla">
				{items.map((item, i) => (
					<li class="termino">
						<a href={`/temas/${item.slug}/`} class="termino-link">
							<span class="termino-num" aria-hidden="true">{aRomano(i + 1)}</span>
							<span class="termino-cuerpo">
								<span class="termino-nombre">{item.display}</span>
								<span class="termino-conteo">
									{item.conteo === 1 ? '1 fábula' : `${item.conteo} fábulas`}
								</span>
							</span>
						</a>
					</li>
				))}
			</ol>
		</main>
		<Footer />
	</body>
</html>

<style>
	.indice-taxonomia {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6.25rem);
	}

	/* ── Cabecera (handoff §2, patrón Fase 2): eyebrow → H1 → intro ────────── */
	.cabecera {
		margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}
	.cabecera h1 {
		margin: var(--space-md) 0 0;
		font-size: var(--fs-3xl);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		text-wrap: balance;
	}
	.intro {
		margin: var(--space-md) 0 0;
		max-width: 41rem;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
	}

	/* ── Catálogo de términos: fichas con numeral romano (patrón Fase 4) ───── */
	.rejilla {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: var(--rule-thin) solid var(--color-oro);
		padding-top: var(--space-lg);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: clamp(12px, 1.5vw, 20px);
	}
	.termino-link {
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
		height: 100%;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md);
		border: var(--rule-thin) solid rgba(201, 161, 74, 0.7);
		transition:
			background-color var(--dur-fast) var(--ease-standard),
			border-color var(--dur-fast) var(--ease-standard);
	}
	.termino-link:hover,
	.termino-link:focus-visible {
		background-color: rgba(201, 161, 74, 0.12);
		border-color: var(--color-oro);
	}
	.termino-num {
		flex: none;
		font-family: var(--font-display);
		font-size: var(--fs-sm);
		letter-spacing: var(--ls-wide);
		color: var(--color-oro-texto);
		line-height: 1;
	}
	.termino-cuerpo {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}
	.termino-nombre {
		font-family: var(--font-display);
		font-size: var(--fs-md);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		color: var(--color-text);
	}
	.termino-link:hover .termino-nombre,
	.termino-link:focus-visible .termino-nombre {
		color: var(--color-oro-texto);
	}
	.termino-conteo {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-oro-texto);
	}
</style>
