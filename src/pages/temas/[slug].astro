---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ListadoFabulasTaxonomia from '../../components/ListadoFabulasTaxonomia.astro';
import { TEMAS_DISPLAY, type Tema } from '../../utils/taxonomia';

export async function getStaticPaths() {
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
	const autores = await getCollection('autores');
	const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

	const porSlug = new Map<string, typeof fabulas>();
	for (const f of fabulas) {
		for (const t of f.data.temas) {
			if (!porSlug.has(t)) porSlug.set(t, []);
			porSlug.get(t)!.push(f);
		}
	}

	return Array.from(porSlug.entries()).map(([slug, fs]) => ({
		params: { slug },
		props: {
			slug: slug as Tema,
			fabulas: fs.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
			autorMap,
		},
	}));
}

const { slug, fabulas, autorMap } = Astro.props;
const display = TEMAS_DISPLAY[slug];
const contadorTexto =
	fabulas.length === 1
		? '1 fábula sobre este tema'
		: `${fabulas.length} fábulas sobre este tema`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Tema: ${display} · El Fabulario`}
			description={`Fábulas sobre ${display.toLowerCase()} en El Fabulario.`}
		/>
	</head>
	<body>
		<Header />
		<ListadoFabulasTaxonomia
			rotulo="Tema"
			display={display}
			fabulas={fabulas}
			autorMap={autorMap}
			contadorTexto={contadorTexto}
			vacioTexto="Aún no hay fábulas publicadas sobre este tema."
		/>
		<Footer />
	</body>
</html>