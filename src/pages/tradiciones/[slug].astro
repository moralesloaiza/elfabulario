---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ListadoFabulasTaxonomia from '../../components/ListadoFabulasTaxonomia.astro';
import { TRADICIONES_DISPLAY, type Tradicion } from '../../utils/taxonomia';

export async function getStaticPaths() {
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
	const autores = await getCollection('autores');
	const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

	const porSlug = new Map<string, typeof fabulas>();
	for (const f of fabulas) {
		const k = f.data.tradicion;
		if (!k) continue; // tradicion es opcional
		if (!porSlug.has(k)) porSlug.set(k, []);
		porSlug.get(k)!.push(f);
	}

	return Array.from(porSlug.entries()).map(([slug, fs]) => ({
		params: { slug },
		props: {
			slug: slug as Tradicion,
			fabulas: fs.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
			autorMap,
		},
	}));
}

const { slug, fabulas, autorMap } = Astro.props;
const display = TRADICIONES_DISPLAY[slug];
const contadorTexto =
	fabulas.length === 1
		? '1 fábula de esta tradición'
		: `${fabulas.length} fábulas de esta tradición`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Tradición: ${display} · El Fabulario`}
			description={`Fábulas de tradición ${display.toLowerCase()} en El Fabulario.`}
		/>
	</head>
	<body>
		<Header />
		<ListadoFabulasTaxonomia
			rotulo="Tradición"
			display={display}
			fabulas={fabulas}
			autorMap={autorMap}
			contadorTexto={contadorTexto}
			vacioTexto="Aún no hay fábulas publicadas de esta tradición."
		/>
		<Footer />
	</body>
</html>