---
import { getCollection, render } from 'astro:content';
import Autor, { type FabulaFila } from '../../layouts/Autor.astro';
import { tiempoLecturaMin } from '../../utils/lectura';
import { FORMAS_DISPLAY } from '../../utils/taxonomia';

export async function getStaticPaths() {
	const autores = await getCollection('autores');
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);

	return autores.map((autor) => {
		// Fábulas del autor, más recientes primero. Los minutos de lectura se
		// calculan aquí (getStaticPaths ve el body de cada fábula) y se pasan al
		// layout ya resueltos.
		const fabulasDelAutor: FabulaFila[] = fabulas
			.filter((f) => f.data.autor.id === autor.id)
			.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
			.map((f) => ({
				id: f.id,
				titulo: f.data.titulo,
				formaDisplay: FORMAS_DISPLAY[f.data.forma],
				minutos: tiempoLecturaMin(f.body),
			}));

		return {
			params: { slug: autor.id },
			props: { autor, fabulas: fabulasDelAutor },
		};
	});
}

const { autor, fabulas } = Astro.props;
const { Content } = await render(autor);
---

<Autor autor={autor} fabulas={fabulas}>
	<Content />
</Autor>
