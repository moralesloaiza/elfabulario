---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sol from '../../components/ornaments/Sol.astro';

export async function getStaticPaths() {
	const autores = await getCollection('autores');
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);

	return autores.map((autor) => {
		const fabulasDelAutor = fabulas
			.filter((f) => f.data.autor === autor.data.nombre)
			.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

		return {
			params: { slug: autor.id },
			props: { autor, fabulas: fabulasDelAutor },
		};
	});
}

const { autor, fabulas } = Astro.props;
const { Content } = await render(autor);

const {
	nombre,
	tipo,
	imagen,
	nacionalidad,
	nacimiento,
	muerte,
	siglo,
	enlaces,
} = autor.data;

// Línea biográfica para autores clásicos: "español · 1745–1801".
const epoca =
	nacimiento && muerte
		? `${nacimiento}–${muerte}`
		: siglo
			? `siglo ${siglo}`
			: null;
const datos = [nacionalidad, epoca].filter(Boolean).join(' · ');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${nombre} · El Fabulario`} description={`Fábulas de ${nombre} en El Fabulario.`} />
	</head>
	<body>
		<Header />
		<main class="page autor-page">
			<header class="title">
				<Sol width="80px" />
				<h1>{nombre}</h1>
				{tipo === 'clasico' && datos && <p class="datos">{datos}</p>}
			</header>

			{imagen && (
				<figure class="retrato">
					<Image src={imagen} alt={`Retrato de ${nombre}`} width={400} height={400} />
				</figure>
			)}

			<div class="bio prose">
				<Content />
			</div>

			{tipo === 'colaborador' && enlaces && enlaces.length > 0 && (
				<ul class="enlaces">
					{enlaces.map((e) => (
						<li><a href={e.url} rel="noopener noreferrer" target="_blank">{e.etiqueta}</a></li>
					))}
				</ul>
			)}

			<hr class="ornate" />

			<section class="fabulas-del-autor" aria-labelledby="lista-titulo">
				<h2 id="lista-titulo">
					{fabulas.length === 1
						? '1 fábula en el Fabulario'
						: `${fabulas.length} fábulas en el Fabulario`}
				</h2>

				{fabulas.length === 0 && (
					<p class="vacio">Aún no hay fábulas publicadas de este autor.</p>
				)}

				{fabulas.length > 0 && (
					<ul class="lista">
						{fabulas.map((f) => (
							<li class="item">
								<a href={`/fabulas/${f.id}/`} class="item-link">
									<h3 class="item-titulo">{f.data.titulo}</h3>
									<p class="item-fecha">
										<FormattedDate date={f.data.fecha} />
									</p>
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.autor-page {
		max-width: var(--measure);
		margin-inline: auto;
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-lg);
	}
	.title h1 {
		margin: 0 0 var(--space-2xs);
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.datos {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
		margin: 0;
	}
	.retrato {
		margin: 0 auto var(--space-xl);
		max-width: 280px;
	}
	.retrato :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: var(--rule-hairline) solid var(--color-oro);
		border-radius: 50%;
	}
	.bio {
		max-width: var(--measure-narrow);
		margin: 0 auto var(--space-xl);
	}
	.bio :global(p) {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
		hyphens: auto;
	}
	.enlaces {
		list-style: none;
		padding: 0;
		margin: 0 auto var(--space-xl);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-md);
		max-width: var(--measure-narrow);
	}
	.enlaces a {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		color: var(--color-esmeralda);
		text-decoration: none;
		border-bottom: var(--rule-hairline) solid var(--color-esmeralda);
		padding-bottom: 2px;
	}
	.fabulas-del-autor h2 {
		text-align: center;
		font-family: var(--font-display);
		font-size: var(--fs-md);
		letter-spacing: var(--ls-wide);
		color: var(--color-oro-texto);
		margin: var(--space-xl) 0 var(--space-lg);
	}
	.vacio {
		text-align: center;
		font-style: italic;
		color: var(--color-text-soft);
	}
	.lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-lg);
	}
	.item-link {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md);
		border: var(--rule-hairline) solid var(--color-oro);
		transition: background-color var(--dur-fast) var(--ease-standard);
	}
	.item-link:hover,
	.item-link:focus-visible {
		background-color: rgba(0, 0, 0, 0.03);
	}
	.item-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-md);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
	}
	.item-link:hover .item-titulo {
		color: var(--color-oro-texto);
	}
	.item-fecha {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-esmeralda);
		margin: 0;
	}
	@media (max-width: 720px) {
		.lista {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}
</style>
