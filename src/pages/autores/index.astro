---
import { getCollection } from 'astro:content';
import AutorCard from '../../components/AutorCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const autores = await getCollection('autores');
const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);

// Cuenta cuántas fábulas hay por autor. `f.data.autor` es una
// reference('autores'), o sea un objeto { collection, id }; indexamos por
// el slug (`id`) del archivo de autor.
const conteoPorId = new Map<string, number>();
for (const f of fabulas) {
	const k = f.data.autor.id;
	conteoPorId.set(k, (conteoPorId.get(k) ?? 0) + 1);
}

// Enriquecemos y ordenamos: primero por número de fábulas (desc), luego por
// nombre. Surface a los autores más presentes al principio de la rejilla.
const autoresConConteo = autores
	.map((a) => ({ autor: a, conteo: conteoPorId.get(a.id) ?? 0 }))
	.sort((a, b) => {
		if (b.conteo !== a.conteo) return b.conteo - a.conteo;
		return a.autor.data.nombre.localeCompare(b.autor.data.nombre, 'es');
	});

// El párrafo introductorio debe citar el número real de fichas (plan Fase 4).
// El índice está pensado para <30 autores, así que basta cubrir 0–30 en
// palabras; por encima de eso, el numeral.
const total = autoresConConteo.length;
const NUMEROS = [
	'cero', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho',
	'nueve', 'diez', 'once', 'doce', 'trece', 'catorce', 'quince', 'dieciséis',
	'diecisiete', 'dieciocho', 'diecinueve', 'veinte', 'veintiuno', 'veintidós',
	'veintitrés', 'veinticuatro', 'veinticinco', 'veintiséis', 'veintisiete',
	'veintiocho', 'veintinueve', 'treinta',
];
const totalPalabra = NUMEROS[total] ?? String(total);
const totalCap = totalPalabra.charAt(0).toUpperCase() + totalPalabra.slice(1);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Autores · ${SITE_TITLE}`} description="Los fabulistas y traductores reunidos en El Fabulario." />
	</head>
	<body>
		<Header />
		<main class="page indice-autores">
			<header class="cabecera">
				<p class="eyebrow">Índice</p>
				<h1>Autores</h1>
				<p class="intro">
					{totalCap} nombres sostienen la antología: los fabulistas de la Antigüedad,
					sus continuadores europeos y quienes los trajeron al castellano.
				</p>
			</header>

			<ul class="rejilla">
				{autoresConConteo.map(({ autor, conteo }) => (
					<li>
						<AutorCard autor={autor} conteo={conteo} />
					</li>
				))}
			</ul>

			<div class="cierre">
				<p class="cierre-texto">
					¿Falta un fabulista? Propón un autor y las ediciones que deberíamos consultar.
				</p>
				<a class="cierre-cta" href="/colaborar/">Proponer un autor</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.indice-autores {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6.25rem);
	}

	/* Cabecera alineada a la izquierda (handoff §4): eyebrow → H1 → intro. */
	.cabecera {
		margin-bottom: clamp(2.25rem, 4.5vw, 3.75rem);
	}
	.eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-eyebrow);
		text-transform: uppercase;
		color: var(--color-oro-texto);
		margin: 0;
	}
	.cabecera h1 {
		margin: var(--space-md) 0 0;
		font-size: var(--fs-3xl);
		letter-spacing: var(--ls-wider);
		text-transform: uppercase;
		text-wrap: balance;
	}
	.intro {
		margin: var(--space-md) 0 0;
		max-width: 41rem;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-lg);
		line-height: var(--lh-normal);
		color: var(--color-text-soft);
	}

	/* Rejilla plana: sin paginación ni filtros (diseñada para <30 autores).
	   Gap real (no el truco de fondo dorado) para que una fila incompleta no
	   deje celdas rellenas a la vista. */
	.rejilla {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: clamp(22px, 2.6vw, 34px);
	}
	.rejilla > li {
		display: flex;
	}

	/* Cierre: filete oro + frase en cursiva y CTA coral. */
	.cierre {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		border-top: var(--rule-thin) solid var(--color-oro);
		padding-top: clamp(1.5rem, 3vw, 2.25rem);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-lg) var(--space-2xl);
	}
	.cierre-texto {
		margin: 0;
		max-width: 35rem;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
	}
	.cierre-cta {
		font-family: var(--font-display);
		font-size: var(--fs-xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-text-invert);
		background: var(--color-coral);
		border: var(--rule-thin) solid var(--color-coral);
		padding: var(--space-md) var(--space-lg);
		text-decoration: none;
		transition:
			background-color var(--dur-fast) var(--ease-standard),
			color var(--dur-fast) var(--ease-standard);
	}
	.cierre-cta:hover,
	.cierre-cta:focus-visible {
		background: var(--color-negro);
		color: var(--color-coral);
	}
</style>
