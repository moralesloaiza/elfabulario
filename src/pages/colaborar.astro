---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const pagina = await getEntry('paginas', 'colaborar');
if (!pagina) throw new Error('[paginas] Falta src/content/paginas/colaborar.md');
const { Content } = await render(pagina);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Colaborar · ${SITE_TITLE}`} description="Cómo proponer y publicar fábulas en El Fabulario." />
	</head>
	<body>
		<Header />
		<main class="page colaborar">
			<header class="title">
				<h1>{pagina.data.titulo}</h1>
				{pagina.data.subtitulo && <p class="subtitulo">{pagina.data.subtitulo}</p>}
			</header>

			<hr class="ornate" />

			<section class="prose">
				<Content />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.colaborar {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0;
		font-size: var(--fs-3xl);
		text-wrap: balance;
	}
	.prose {
		max-width: var(--measure);
		margin-inline: auto;
	}
	.prose p {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-md);
	}
	.prose h2 {
		font-size: var(--fs-xl);
		margin-top: var(--space-2xl);
		margin-bottom: var(--space-md);
		text-align: center;
	}
	.prose h3 {
		font-size: var(--fs-md);
		font-weight: var(--fw-semibold);
		margin-top: var(--space-md);
		margin-bottom: 0.5em;
	}
	.prose ol {
		margin-bottom: var(--space-md);
		padding-left: 1.5em;
	}
	.prose ol li {
		font-size: var(--fs-md);
		line-height: var(--lh-relaxed);
		margin-bottom: 0.25em;
	}
	.prose code {
		font-family: ui-monospace, monospace;
		font-size: 0.9em;
		padding: 0.1em 0.3em;
		background: rgba(0, 0, 0, 0.05);
		border-radius: 3px;
	}
</style>