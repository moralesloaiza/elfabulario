---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Buscar · ${SITE_TITLE}`} description="Buscar fábulas, autores, personajes y temas." />
	</head>
	<body>
		<Header />
		<main class="page serp">
			<header class="title">
				<h1 data-titulo>Buscar</h1>
				<p class="subtitulo" data-subtitulo>
					Escribe en el campo de búsqueda del menú o pulsa <kbd>/</kbd>.
				</p>
			</header>

			<hr class="ornate" />

			<section class="resultados" hidden data-seccion-entidades>
				<h2>Coincidencias en la taxonomía</h2>
				<ul class="lista-entidades" data-lista-entidades></ul>
			</section>

			<section class="resultados" hidden data-seccion-fabulas>
				<h2>En fábulas <span class="conteo" data-conteo-fabulas></span></h2>
				<ul class="lista-textos" data-lista-fabulas></ul>
			</section>

			<section class="resultados" hidden data-seccion-entradas>
				<h2>En bitácora <span class="conteo" data-conteo-entradas></span></h2>
				<ul class="lista-textos" data-lista-entradas></ul>
			</section>

			<p class="vacio" hidden data-vacio>
				No se encontró nada para esta búsqueda.
			</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	type TipoEntidad = 'autor' | 'personaje' | 'tema' | 'forma' | 'tradicion';

	interface Entidad {
		tipo: TipoEntidad;
		slug: string;
		nombre: string;
		conteo: number;
		url: string;
	}

	const ETIQUETAS_TIPO: Record<TipoEntidad, string> = {
		autor: 'Autor',
		personaje: 'Personaje',
		tema: 'Tema',
		forma: 'Forma',
		tradicion: 'Tradición',
	};

	function norm(s: string): string {
		return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
	}

	function escape(s: string): string {
		return s.replace(/[&<>"']/g, (c) => ({
			'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
		})[c] as string);
	}

	const params = new URLSearchParams(window.location.search);
	const q = (params.get('q') ?? '').trim();

	const titulo = document.querySelector<HTMLElement>('[data-titulo]')!;
	const subtitulo = document.querySelector<HTMLElement>('[data-subtitulo]')!;
	const secEnt = document.querySelector<HTMLElement>('[data-seccion-entidades]')!;
	const secFab = document.querySelector<HTMLElement>('[data-seccion-fabulas]')!;
	const secEnr = document.querySelector<HTMLElement>('[data-seccion-entradas]')!;
	const listaEnt = document.querySelector<HTMLElement>('[data-lista-entidades]')!;
	const listaFab = document.querySelector<HTMLElement>('[data-lista-fabulas]')!;
	const listaEnr = document.querySelector<HTMLElement>('[data-lista-entradas]')!;
	const conteoFab = document.querySelector<HTMLElement>('[data-conteo-fabulas]')!;
	const conteoEnr = document.querySelector<HTMLElement>('[data-conteo-entradas]')!;
	const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;

	if (q) {
		titulo.textContent = `Resultados para «${q}»`;
		subtitulo.hidden = true;
		ejecutar(q);
	}

	async function ejecutar(query: string) {
		// ── Entidades ──
		try {
			const ents: Entidad[] = await fetch('/buscar/entidades.json').then((r) => r.json());
			const qn = norm(query);
			const matches = ents.filter((e) => norm(e.nombre).includes(qn));
			if (matches.length > 0) {
				listaEnt.innerHTML = matches
					.map(
						(e) =>
							`<li><a href="${e.url}">` +
								`<span class="rotulo">${ETIQUETAS_TIPO[e.tipo]}</span>` +
								`<span class="nombre">${escape(e.nombre)}</span>` +
								`<span class="conteo">${e.conteo === 1 ? '1 fábula' : `${e.conteo} fábulas`}</span>` +
							`</a></li>`,
					)
					.join('');
				secEnt.hidden = false;
			}
		} catch {
			/* sin entidades disponibles, seguimos sin esta sección */
		}

		// ── Texto vía Pagefind ──
		let fabulas = 0;
		let entradas = 0;
		try {
			// La URL se construye en runtime para evitar que Rollup intente
			// resolver el módulo en build time (no existe aún).
			const url = '/pagefind/pagefind.js';
			const pf = await import(/* @vite-ignore */ url);
			await pf.init();
			const { results } = await pf.search(query);

			const filasFab: string[] = [];
			const filasEnr: string[] = [];

			for (const r of results) {
				const d = await r.data();
				const url: string = d.url;
				const titulo = d.meta?.title ?? url;
				const autor = d.meta?.author ?? null;
				const excerpt = d.excerpt ?? '';
				const fila =
					`<li><a href="${url}">` +
						`<span class="t-titulo">${escape(titulo)}</span>` +
						(autor ? `<span class="t-autor">· ${escape(autor)}</span>` : '') +
						(excerpt ? `<p class="t-excerpt">${excerpt}</p>` : '') +
					`</a></li>`;
				if (url.includes('/entradas/')) {
					filasEnr.push(fila);
					entradas++;
				} else {
					filasFab.push(fila);
					fabulas++;
				}
			}

			if (fabulas > 0) {
				listaFab.innerHTML = filasFab.join('');
				conteoFab.textContent = `(${fabulas})`;
				secFab.hidden = false;
			}
			if (entradas > 0) {
				listaEnr.innerHTML = filasEnr.join('');
				conteoEnr.textContent = `(${entradas})`;
				secEnr.hidden = false;
			}
		} catch {
			/* Pagefind no disponible — solo entidades */
		}

		// Si no hay nada en ningún sitio, mensaje vacío.
		if (secEnt.hidden && secFab.hidden && secEnr.hidden) {
			vacio.hidden = false;
		}
	}
</script>

<style>
	.serp {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0 0 var(--space-sm);
		font-size: var(--fs-3xl);
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}
	.subtitulo kbd {
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		background: var(--color-bg);
		border: var(--rule-hairline) solid var(--color-oro);
		padding: 0 var(--space-2xs);
		margin: 0 var(--space-3xs);
	}

	.resultados {
		max-width: var(--measure-wide);
		margin: var(--space-2xl) auto 0;
	}
	.resultados h2 {
		font-family: var(--font-display);
		font-size: var(--fs-md);
		letter-spacing: var(--ls-wide);
		color: var(--color-oro-texto);
		font-weight: var(--fw-bold);
		text-transform: uppercase;
		margin: 0 0 var(--space-md);
		padding-bottom: var(--space-2xs);
		border-bottom: var(--rule-hairline) solid var(--color-oro);
	}
	.resultados h2 .conteo {
		font-family: var(--font-body);
		font-style: italic;
		font-weight: var(--fw-regular);
		font-size: var(--fs-sm);
		text-transform: none;
		letter-spacing: 0;
		color: var(--color-text-soft);
		margin-left: var(--space-2xs);
	}

	.lista-entidades,
	.lista-textos {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.lista-entidades li,
	.lista-textos li {
		border-bottom: var(--rule-hairline) solid rgba(201, 161, 74, 0.3);
	}
	.lista-entidades li:last-child,
	.lista-textos li:last-child {
		border-bottom: 0;
	}
	.lista-entidades a,
	.lista-textos a {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: var(--space-md);
		transition: background-color var(--dur-fast) var(--ease-standard);
	}
	.lista-entidades a:hover,
	.lista-textos a:hover {
		background-color: rgba(0, 0, 0, 0.03);
	}

	.lista-entidades a {
		display: grid;
		grid-template-columns: 8rem 1fr auto;
		gap: var(--space-sm);
		align-items: baseline;
	}
	.lista-entidades :global(.rotulo) {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		color: var(--color-oro-texto);
		text-transform: uppercase;
	}
	.lista-entidades :global(.nombre) {
		font-family: var(--font-body);
		font-size: var(--fs-md);
	}
	.lista-entidades :global(.conteo) {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-wide);
		color: var(--color-esmeralda);
	}

	.lista-textos :global(.t-titulo) {
		font-family: var(--font-body);
		font-size: var(--fs-md);
		color: var(--color-text);
	}
	.lista-textos :global(.t-autor) {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		margin-left: var(--space-2xs);
	}
	.lista-textos :global(.t-excerpt) {
		font-family: var(--font-body);
		font-size: var(--fs-sm);
		color: var(--color-text-soft);
		line-height: var(--lh-normal);
		margin: var(--space-2xs) 0 0;
	}
	.lista-textos :global(.t-excerpt mark) {
		background: rgba(201, 161, 74, 0.25);
		color: inherit;
		padding: 0 0.1em;
	}

	.vacio {
		text-align: center;
		font-family: var(--font-body);
		font-style: italic;
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: var(--space-2xl) auto 0;
	}

	@media (max-width: 540px) {
		.lista-entidades a {
			grid-template-columns: 6rem 1fr;
		}
		.lista-entidades :global(.conteo) {
			grid-column: 2;
			margin-top: var(--space-3xs);
		}
	}
</style>