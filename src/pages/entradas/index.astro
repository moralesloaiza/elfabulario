---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sol from '../../components/ornaments/Sol.astro';
import { SITE_TITLE } from '../../consts';

const entradas = (await getCollection('entradas', ({ data }) => !data.borrador)).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Bitácora · ${SITE_TITLE}`}
			description="Anuncios, hitos y notas del Fabulario."
		/>
	</head>
	<body>
		<Header />
		<main class="page bitacora">
			<header class="title">
				<Sol />
				<h1>Bitácora</h1>
				<p class="subtitulo">Anuncios, hitos y notas del Fabulario.</p>
			</header>

			<hr class="ornate" />

			{entradas.length === 0 && (
				<p class="vacio">Aún no hay entradas en la bitácora.</p>
			)}

			{entradas.length > 0 && (
				<ul class="lista">
					{entradas.map((entrada) => (
						<li class="item">
							<a href={`/entradas/${entrada.id}/`} class="item-link">
								{entrada.data.ilustracion && (
									<figure class="item-img">
										<Image
											width={600}
											height={400}
											src={entrada.data.ilustracion}
											alt=""
										/>
									</figure>
								)}
								<div class="item-meta">
									<h2 class="item-titulo">{entrada.data.titulo}</h2>
									<p class="item-fecha">
										<FormattedDate date={entrada.data.fecha} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.bitacora {
		padding-block: var(--space-2xl);
	}
	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0 0 var(--space-sm);
		font-size: var(--fs-3xl);
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}
	.vacio {
		text-align: center;
		font-style: italic;
		color: var(--color-text-soft);
		margin-top: var(--space-2xl);
	}
	.lista {
		list-style: none;
		padding: 0;
		margin: var(--space-2xl) 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		max-width: none;
	}
	.item-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.item-img {
		margin: 0 0 var(--space-md);
		overflow: hidden;
	}
	.item-img :global(img) {
		display: block;
		width: 100%;
		height: auto;
		/*transition: transform var(--dur-slow) var(--ease-standard);*/
	}
	.item-link:hover .item-img :global(img),
	.item-link:focus-visible .item-img :global(img) {
		transform: scale(1.02);
	}
	.item-titulo {
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: var(--fw-bold);
		letter-spacing: var(--ls-wide);
		line-height: var(--lh-snug);
		margin: 0 0 var(--space-2xs);
		color: var(--color-text);
		text-transform: none;
	}
	.item-link:hover .item-titulo,
	.item-link:focus-visible .item-titulo {
		color: var(--color-oro-texto);
	}
	.item-fecha {
		font-family: var(--font-display);
		font-size: var(--fs-3xs);
		letter-spacing: var(--ls-widest);
		text-transform: uppercase;
		color: var(--color-esmeralda);
		margin: var(--space-2xs) 0 0;
	}
	@media (max-width: 720px) {
		.lista {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
