---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import ListadoFabulasTaxonomia from '../../components/ListadoFabulasTaxonomia.astro';
import { buildBreadcrumbJsonLd } from '../../utils/jsonld';
import { FORMAS_DISPLAY, type Forma } from '../../utils/taxonomia';

export async function getStaticPaths() {
	const fabulas = await getCollection('fabulas', ({ data }) => !data.borrador);
	const autores = await getCollection('autores');
	const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

	const porSlug = new Map<string, typeof fabulas>();
	for (const f of fabulas) {
		const k = f.data.forma;
		if (!porSlug.has(k)) porSlug.set(k, []);
		porSlug.get(k)!.push(f);
	}

	return Array.from(porSlug.entries()).map(([slug, fs]) => ({
		params: { slug },
		props: {
			slug: slug as Forma,
			fabulas: fs.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
			autorMap,
		},
	}));
}

const { slug, fabulas, autorMap } = Astro.props;
const display = FORMAS_DISPLAY[slug];
const contadorTexto =
	fabulas.length === 1
		? `1 fábula en ${display.toLowerCase()}`
		: `${fabulas.length} fábulas en ${display.toLowerCase()}`;

const breadcrumbLd = buildBreadcrumbJsonLd(
	[
		{ name: 'Inicio', path: '/' },
		{ name: display, path: `/formas/${slug}/` },
	],
	Astro.site!,
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Forma: ${display} · El Fabulario`}
			description={`Fábulas en ${display.toLowerCase()} en El Fabulario.`}
		/>
		<JsonLd data={breadcrumbLd} />
	</head>
	<body>
		<Header />
		<ListadoFabulasTaxonomia
			rotulo="Forma"
			display={display}
			fabulas={fabulas}
			autorMap={autorMap}
			contadorTexto={contadorTexto}
			vacioTexto={`Aún no hay fábulas publicadas en ${display.toLowerCase()}.`}
		/>
		<Footer />
	</body>
</html>