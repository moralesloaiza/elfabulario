---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FabulaCard from '../../components/FabulaCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const fabulas = (await getCollection('fabulas', ({ data }) => !data.borrador)).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

// Author names live in the `autores` collection now (the `autor` field on a
// fable is a reference, not a string). Build an id→name map once so the
// template can render the author without awaiting per row.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Fábulas · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page indice">
			<header class="title">
				<h1>Fábulas</h1>
				<p class="subtitulo">El catálogo completo, de la más reciente a la más antigua.</p>
			</header>

			<hr class="ornate" />

			{fabulas.length === 0 ? (
				<p class="vacio">Aún no hay fábulas publicadas.</p>
			) : (
				<ul class="lista">
					{fabulas.map((fabula) => (
						<li>
							<FabulaCard
								fabula={fabula}
								autorNombre={autoresPorId.get(fabula.data.autor.id) ?? ''}
							/>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.indice {
		padding-block: var(--space-2xl);
	}

	.title {
		text-align: center;
		margin-bottom: var(--space-md);
	}
	.title h1 {
		margin: 0 0 var(--space-sm);
		font-size: var(--fs-3xl);
	}
	.subtitulo {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--fs-md);
		color: var(--color-text-soft);
		max-width: var(--measure-narrow);
		margin: 0 auto;
	}

	.vacio {
		text-align: center;
		font-style: italic;
		color: var(--color-text-soft);
		margin-top: var(--space-2xl);
	}

	.lista {
		list-style: none;
		padding: 0;
		margin: var(--space-2xl) 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		max-width: none;
	}

	@media (max-width: 720px) {
		.lista {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>